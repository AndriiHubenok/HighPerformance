INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/116',11,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','\u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435 ''${1}'' \u043f\u043e\u043b\u044f ''${0}'' \u043d\u0435 \u0441\u0441\u044b\u043b\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u0432\u0435\u0440\u043d\u044b\u0439 \u043e\u0431\u044a\u0435\u043a\u0442. \u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0443\u044e \u0441\u0441\u044b\u043b\u043a\u0443 \u043d\u0430 \u043b\u044e\u0431\u043e\u0439 \u043e\u0431\u044a\u0435\u043a\u0442 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0432\u044b\u043f\u0430\u0434\u0430\u044e\u0449\u0435\u0433\u043e \u0441\u043f\u0438\u0441\u043a\u0430 \u0438\u043b\u0438 \u0441\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0443\u044e \u0441\u0441\u044b\u043b\u043a\u0443',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/116',12,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Cecha/warto\u015bci ''${1}'' pola''${0}'' nie jest poprawnym obiektem. Mo\u017cesz ustawi\u0107 poprawne odniesienie razem z przegl\u0105dem obiektu albo skopiuj poprawne odniesienie',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/116',13,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','\u30d5\u30a3\u30fc\u30eb\u30c9''${0}''\u306e\u5024''${1}''\u306f\u6709\u52b9\u306a\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u53c2\u7167\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u691c\u7d22\u3092\u884c\u3046\u304b\u307e\u305f\u306f\u6709\u52b9\u306a\u53c2\u7167\u3092\u30b3\u30d4\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u6709\u52b9\u306a\u53c2\u7167\u3092\u8a2d\u5b9a\u3059\u308b\u3053\u3068\u304c\u53ef\u80fd\u3067\u3059\u3002',NULL)
