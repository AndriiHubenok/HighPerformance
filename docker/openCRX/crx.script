INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',23,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Zlyhanie pr\u00edstupu k m\u00e9di\u00e1m. Mo\u017en\u00e9 d\u00f4vody s\u00fa: hodnota po\u013ea je pr\u00edli\u0161 dlh\u00e1, datab\u00e1zov\u00e1 tabu\u013eka bola po\u0161koden\u00e1 alebo je neplatn\u00e1, datab\u00e1za nie je dostupn\u00e1. Pozri log s detailami ${0}',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',24,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Acces e\u015fuat la suportul de \u00eenregistrare. Motive posibile: c\u00e2mp valoric prea lung, tabelul bazei de date distrus sau inexistent, baz\u0103 de date indisponibil\u0103. Vezi fi\u015fierul log pentru detalii: ${0}',NULL)
