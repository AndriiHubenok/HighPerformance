CREATE VIEW PUBLIC.OOCKE1_JOIN_WFPROCHASPROCINST (WF_PROCESS,WF_PROCESS_INSTANCE) AS SELECT WFP.PROCESS AS WF_PROCESS,WFP.OBJECT_ID AS WF_PROCESS_INSTANCE FROM PUBLIC.OOCKE1_WFPROCESSINSTANCE WFP
