INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/116',15,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Hodnota ''${1}'' pole ''${0}'' se neodkazuje na spr\u00e1vn\u00fd objekt. M\u00f9\u017eete nastavit spr\u00e1vn\u00fd odkaz bu\u00efto vyhled\u00e1n\u00edm objektu nebo kop\u00edrov\u00e1n\u00edm zpr\u00e1vn\u00e9ho odkazu.',NULL)
