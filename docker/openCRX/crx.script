INSERT INTO OOCKE1_PRICINGRULE VALUES('pricingRule/CRX/Standard/LowestPriceRule',4,1,1,0,'2008-06-24 17:09:05.046000',1,'Get price level which returns the lowest price of the given product, contract currency, pricing date and quantity. If the product is not defined return the price level which matches the contract currency, price uom and pricing date.',NULL,NULL,0,'//<pre>\u000apublic static org.opencrx.kernel.product1.jmi1.GetPriceLevelResult getPriceLevel(\u000a    org.openmdx.base.accessor.jmi.cci.RefPackage_1_0 rootPkg,\u000a    org.opencrx.kernel.product1.jmi1.PricingRule pricingRule,\u000a    org.opencrx.kernel.contract1.jmi1.AbstractContract contract,\u000a    org.opencrx.kernel.product1.jmi1.AbstractProduct product,\u000a    org.opencrx.kernel.uom1.jmi1.Uom priceUom,\u000a    java.math.BigDecimal quantity,\u000a    java.util.Date pricingDate\u000a) {\u000a\u0009return org.opencrx.kernel.backend.Products.getLowestPricePriceLevel(\u000a\u0009\u0009rootPkg,\u000a\u0009\u0009pricingRule,\u000a\u0009\u0009contract,\u000a\u0009\u0009product,\u000a\u0009\u0009priceUom,\u000a\u0009\u0009quantity,\u000a\u0009\u0009pricingDate\u000a\u0009);\u000a}\u000a//</pre>',TRUE,1,'Lowest Price',2,'products/CRX/Standard',NULL,NULL,NULL,NULL,0,NULL,NULL,NULL,NULL,0,NULL,NULL,NULL,NULL,0,NULL,NULL,NULL,NULL,0,NULL,NULL,NULL,NULL,0,NULL,NULL,NULL,NULL,0,'2008-10-13 17:20:36.562000','org:opencrx:kernel:product1:PricingRule',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL)
