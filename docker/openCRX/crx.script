CREATE VIEW PUBLIC.OOCKE1_JOIN_DEPHASDEPREF (DEPOT,DEPOT_REFERENCE) AS SELECT DR.DEPOT AS DEPOT,DR.OBJECT_ID AS DEPOT_REFERENCE FROM PUBLIC.OOCKE1_DEPOTREFERENCE DR
CREATE VIEW PUBLIC.OOCKE1_JOIN_DEPPOSHASDEPPOSREF (DEPOT_POSITION,DEPOT_POSITION_REFERENCE) AS SELECT DR.DEPOT_POSITION AS DEPOT_POSITION,DR.OBJECT_ID AS DEPOT_POSITION_REFERENCE FROM PUBLIC.OOCKE1_DEPOTREFERENCE DR
CREATE VIEW PUBLIC.OOCKE1_JOIN_FILTERINCLDESBK (BOOKING_FILTER,FILTERED_SINGLE_BOOKING) AS SELECT F.OBJECT_ID AS BOOKING_FILTER,BK.OBJECT_ID AS FILTERED_SINGLE_BOOKING FROM PUBLIC.OOCKE1_FILTER F INNER JOIN PUBLIC.OOCKE1_BOOKING BK ON(1=1)
CREATE VIEW PUBLIC.OOCKE1_JOIN_FILTERINCLDESCB (BOOKING_FILTER,FILTERED_COMPOUND_BOOKING) AS SELECT F.OBJECT_ID AS BOOKING_FILTER,CB.OBJECT_ID AS FILTERED_COMPOUND_BOOKING FROM PUBLIC.OOCKE1_FILTER F INNER JOIN PUBLIC.OOCKE1_COMPOUNDBOOKING CB ON(1=1)
CREATE VIEW PUBLIC.OOCKE1_JOIN_FILTERINCLDESIL (INVENTORY_LEVEL_FILTER,FILTERED_INVENTORY_LEVEL) AS SELECT F.OBJECT_ID AS INVENTORY_LEVEL_FILTER,IL.OBJECT_ID AS FILTERED_INVENTORY_LEVEL FROM PUBLIC.OOCKE1_FILTER F INNER JOIN PUBLIC.OOCKE1_INVENTORYLEVEL IL ON(1=1)
CREATE VIEW PUBLIC.OOCKE1_JOIN_FILTERINCLDESSBK (BOOKING_FILTER,FILTERED_SIMPLE_BOOKING) AS SELECT F.OBJECT_ID AS BOOKING_FILTER,SBK.OBJECT_ID AS FILTERED_SIMPLE_BOOKING FROM PUBLIC.OOCKE1_FILTER F INNER JOIN PUBLIC.OOCKE1_SIMPLEBOOKING SBK ON(1=1)
CREATE VIEW PUBLIC.OOCKE1_JOIN_OBJISINVOLVEDIN (INVOLVED_IN_OBJECT,INVOLVED_OBJECT) AS SELECT I.OBJECT_ID AS INVOLVED_IN_OBJECT,I.INVOLVED AS INVOLVED_OBJECT FROM PUBLIC.OOCKE1_INVOLVEDOBJECT I
CREATE VIEW PUBLIC.OOCKE1_JOIN_SNAPCONTAINSCURITM (CURRENT_ITEM,SNAPSHOT) AS SELECT WLI_.OBJECT_ID AS CURRENT_ITEM,WLI_.SNAPSHOT AS SNAPSHOT FROM PUBLIC.OOCKE1_WORKLISTITEM_ WLI_
CREATE VIEW PUBLIC.OOCKE1_JOIN_WLCONTAINSCURITM (CURRENT_ITEM,WORK_LIST) AS SELECT WLI_.OBJECT_ID AS CURRENT_ITEM,WL.OBJECT_ID AS WORK_LIST FROM PUBLIC.OOCKE1_WORKLIST WL INNER JOIN PUBLIC.OOCKE1_WORKLISTITEM_ WLI_ ON WLI_.SNAPSHOT=WL.CURRENT_SNAPSHOT
CREATE VIEW PUBLIC.OOCKE1_JOIN_FILTERINCLPROD (PRODUCT_FILTER,FILTERED_PRODUCT) AS SELECT F.OBJECT_ID AS PRODUCT_FILTER,P.OBJECT_ID AS FILTERED_PRODUCT FROM PUBLIC.OOCKE1_FILTER F INNER JOIN PUBLIC.OOCKE1_PRODUCT P ON(1=1)
CREATE VIEW PUBLIC.OOCKE1_JOIN_PLINCLPROD (PRODUCT_FILTER,FILTERED_PRODUCT) AS SELECT F.OBJECT_ID AS PRODUCT_FILTER,P.OBJECT_ID AS FILTERED_PRODUCT FROM PUBLIC.OOCKE1_PRICELEVEL F INNER JOIN PUBLIC.OOCKE1_PRODUCT P ON(1=1)
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
ALTER SEQUENCE PUBLIC.OOCKE1_ACTIVITY_NUMBER_SEQ RESTART WITH 1000000
ALTER SEQUENCE PUBLIC.OOCKE1_POSITION_NUMBER_SEQ RESTART WITH 1000100
SET DATABASE DEFAULT INITIAL SCHEMA PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.SQL_IDENTIFIER TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.YES_OR_NO TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.TIME_STAMP TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.CARDINAL_NUMBER TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.CHARACTER_DATA TO PUBLIC
GRANT DBA TO SA
SET SCHEMA SYSTEM_LOBS
INSERT INTO BLOCKS VALUES(0,2147483647,0)
SET SCHEMA PUBLIC
