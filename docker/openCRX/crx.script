CREATE MEMORY TABLE PUBLIC.OOCKE1_WORKLIST(OBJECT_ID VARCHAR(250) NOT NULL PRIMARY KEY,ACCESS_LEVEL_BROWSE SMALLINT,ACCESS_LEVEL_DELETE SMALLINT,ACCESS_LEVEL_UPDATE SMALLINT,CREATED_AT TIMESTAMP,CREATED_BY_ INTEGER DEFAULT -1,CURRENT_SNAPSHOT VARCHAR(256),DESCRIPTION VARCHAR(256),MODIFIED_BY_ INTEGER DEFAULT -1,NAME VARCHAR(256),OWNER_ INTEGER DEFAULT -1,"P$$PARENT" VARCHAR(256),DTYPE VARCHAR(256),MODIFIED_AT TIMESTAMP)
CREATE MEMORY TABLE PUBLIC.OOCKE1_WORKLISTFEED(OBJECT_ID VARCHAR(250) NOT NULL PRIMARY KEY,ACCESS_LEVEL_BROWSE SMALLINT,ACCESS_LEVEL_DELETE SMALLINT,ACCESS_LEVEL_UPDATE SMALLINT,ACTIVE BOOLEAN,CREATED_AT TIMESTAMP,CREATED_BY_ INTEGER DEFAULT -1,DESCRIPTION VARCHAR(256),MODIFIED_BY_ INTEGER DEFAULT -1,NAME VARCHAR(256),OWNER_ INTEGER DEFAULT -1,SOURCE VARCHAR(256),SOURCE_REFERENCE_NAME VARCHAR(256),"P$$PARENT" VARCHAR(256),DTYPE VARCHAR(256),MODIFIED_AT TIMESTAMP)
