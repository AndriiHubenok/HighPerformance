INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/144',11,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','\u0421\u043f\u0435\u0446\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440: (\u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c, \u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u044f\u0439\u0442\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0435\u0441\u043b\u0438 \u043d\u0435 \u0443\u0432\u0435\u0440\u0435\u043d\u044b \u0432 \u0442\u043e\u043c \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442\u0435...)',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/144',12,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Kwalifikator: (musi by\u0107 unikatowy, i.e. zostawi nie zmieniony do czasu ktorego b\u0119dziesz wiedzia\u0142  co robisz...)',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/144',13,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','\u9650\u5b9a\u5b50: (\u4e00\u610f\u3067\u3042\u308b\u5fc5\u8981\u6709\u308a, \u4f55\u3092\u3057\u3066\u3044\u308b\u306e\u304b\u308f\u304b\u3089\u306a\u3044\u5834\u5408\u306b\u306f\u3001\u305d\u306e\u307e\u307e\u306b\u3057\u3066\u4e0b\u3055\u3044)',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/144',14,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Qualificador: (deve ser \u00fanico, i.e., n\u00e3o altere os valores, a menos que voc\u00ea saiba o que esteja fazendo...)',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/144',15,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Pravidlo: (mus\u00ed b\u00fdt jedine\u00e8n\u00e9 , nebo nechte v\u00fdchoz\u00ed hodnotu ...)',NULL)
