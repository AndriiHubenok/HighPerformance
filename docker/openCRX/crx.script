CREATE MEMORY TABLE PUBLIC.OOCKE1_VALUERANGE(OBJECT_ID VARCHAR(256) NOT NULL PRIMARY KEY,ACCESS_LEVEL_BROWSE SMALLINT,ACCESS_LEVEL_DELETE SMALLINT,ACCESS_LEVEL_UPDATE SMALLINT,CREATED_AT TIMESTAMP,CREATED_BY_ INTEGER DEFAULT -1,DESCRIPTION VARCHAR(256),FORMAT VARCHAR(256),IDENTITY_PATTERN VARCHAR(256),MODIFIED_BY_ INTEGER DEFAULT -1,NAME VARCHAR(256),NEXT_VALUE INTEGER,OWNER_ INTEGER DEFAULT -1,"P$$PARENT" VARCHAR(256),STORAGE_PATH VARCHAR(256),DTYPE VARCHAR(256),MODIFIED_AT TIMESTAMP,START_VALUE INTEGER,SEQUENCE_PROVIDER_URI VARCHAR(256),DISABLED BOOLEAN,ARGUMENT_ INTEGER DEFAULT -1,OBJECT_TYPE_ INTEGER DEFAULT -1,QUERY_TYPE VARCHAR(256),QUERY VARCHAR(256),INCREMENT_VALUE INTEGER)
