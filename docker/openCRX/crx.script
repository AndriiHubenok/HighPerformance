CREATE VIEW PUBLIC.OOMSE2_TOBJ_USERS_ALL (PRINCIPAL_NAME,PASSWD) AS SELECT CASE WHEN R.NAME='Default'THEN P.NAME ELSE R.NAME||'\'||P.NAME END AS PRINCIPAL_NAME,(SELECT C1.PASSWD FROM PUBLIC.OOMSE2_PRINCIPAL P1 INNER JOIN PUBLIC.OOMSE2_REALM R1 ON P1."P$$PARENT"=R1.OBJECT_ID INNER JOIN PUBLIC.OOMSE2_CREDENTIAL C1 ON(P1.CREDENTIAL=C1.OBJECT_ID)WHERE R1.NAME='Default'AND P.NAME=P1.NAME)AS PASSWD FROM PUBLIC.OOMSE2_REALM R INNER JOIN PUBLIC.OOMSE2_PRINCIPAL P ON P."P$$PARENT"=R.OBJECT_ID WHERE R.NAME<>'Root'
CREATE MEMORY TABLE PUBLIC.OOCKE1_BUDGETPOSITION_(OBJECT_ID VARCHAR(256) NOT NULL,IDX INTEGER NOT NULL,CATEGORY VARCHAR(256),CREATED_BY VARCHAR(256),EXTERNAL_LINK VARCHAR(256),MODIFIED_BY VARCHAR(256),OWNER VARCHAR(256),USER_BOOLEAN4 BIT(1),USER_CODE4 SMALLINT,USER_DATE4 DATE,USER_DATE_TIME4 TIMESTAMP,USER_NUMBER4 NUMERIC(100,10),USER_STRING4 VARCHAR(256),DTYPE VARCHAR(256),PRIMARY KEY(OBJECT_ID,IDX))
CREATE VIEW PUBLIC.OOCKE1_JOIN_ACCTHASASSACT (ASSIGNED_ACTIVITY,ACCOUNT) AS SELECT ACT.OBJECT_ID AS ASSIGNED_ACTIVITY,ACC.OBJECT_ID AS ACCOUNT FROM PUBLIC.OOCKE1_ACTIVITY ACT INNER JOIN PUBLIC.OOCKE1_ACCOUNT ACC ON(ACT.ASSIGNED_TO=ACC.OBJECT_ID)OR(ACT.REP_CONTACT=ACC.OBJECT_ID)OR(ACT.REP_ACCT=ACC.OBJECT_ID)UNION SELECT ACT.OBJECT_ID AS ASSIGNED_ACTIVITY,ADR."P$$PARENT" AS ACCOUNT FROM PUBLIC.OOCKE1_ACTIVITY ACT INNER JOIN PUBLIC.OOCKE1_ADDRESS ADR ON(ADR.OBJECT_ID=ACT.SENDER)UNION SELECT(P0."P$$PARENT")AS ASSIGNED_ACTIVITY,ACC.OBJECT_ID AS ACCOUNT FROM PUBLIC.OOCKE1_ACTIVITYPARTY P0 INNER JOIN PUBLIC.OOCKE1_ACCOUNT ACC ON(ACC.OBJECT_ID=P0.PARTY)UNION SELECT(P0."P$$PARENT")AS ASSIGNED_ACTIVITY,ADR."P$$PARENT" AS ACCOUNT FROM PUBLIC.OOCKE1_ACTIVITYPARTY P0 INNER JOIN PUBLIC.OOCKE1_ADDRESS ADR ON(ADR.OBJECT_ID=P0.PARTY)UNION SELECT ACT.OBJECT_ID AS ASSIGNED_ACTIVITY,C0.CUSTOMER AS ACCOUNT FROM PUBLIC.OOCKE1_ACTIVITY_ ACT INNER JOIN PUBLIC.OOCKE1_CONTRACT C0 ON(ACT.CONTRACT=C0.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_ACCTHASPROD (PRODUCT,ACCOUNT) AS SELECT DISTINCT P.OBJECT_ID AS PRODUCT,A.OBJECT_ID AS ACCOUNT FROM PUBLIC.OOCKE1_PRODUCT P,PUBLIC.OOCKE1_ACCOUNT A,PUBLIC.OOCKE1_CONTRACT C,PUBLIC.OOCKE1_CONTRACTPOSITION CP WHERE(CP.PRODUCT=P.OBJECT_ID)AND(CP."P$$PARENT"=C.OBJECT_ID)AND(C.CUSTOMER=A.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_ACTGCONTAINSACT (FILTERED_ACTIVITY,ACTIVITY_GROUP) AS SELECT DISTINCT(GA."P$$PARENT")AS FILTERED_ACTIVITY,GA.ACTIVITY_GROUP AS ACTIVITY_GROUP FROM PUBLIC.OOCKE1_ACTIVITYGROUPASS GA
CREATE VIEW PUBLIC.OOCKE1_JOIN_ACTGCONTAINSFLUP (FOLLOW_UP,ACTIVITY_GROUP) AS SELECT DISTINCT F.OBJECT_ID AS FOLLOW_UP,G.OBJECT_ID AS ACTIVITY_GROUP FROM PUBLIC.OOCKE1_ACTIVITYFOLLOWUP F INNER JOIN PUBLIC.OOCKE1_ACTIVITYGROUPASS GA ON(F."P$$PARENT"=GA."P$$PARENT")INNER JOIN PUBLIC.OOCKE1_ACTIVITYGROUP G ON(GA.ACTIVITY_GROUP=G.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_ACTGCONTAINSNOTE (ACTIVITY_NOTE,ACTIVITY_GROUP) AS SELECT DISTINCT N.OBJECT_ID AS ACTIVITY_NOTE,G.OBJECT_ID AS ACTIVITY_GROUP FROM PUBLIC.OOCKE1_NOTE N INNER JOIN PUBLIC.OOCKE1_ACTIVITYGROUPASS GA ON(N."P$$PARENT"=GA."P$$PARENT")INNER JOIN PUBLIC.OOCKE1_ACTIVITYGROUP G ON(GA.ACTIVITY_GROUP=G.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_CBHASBK (BOOKING,CB) AS SELECT B.OBJECT_ID AS BOOKING,CB.OBJECT_ID AS CB FROM PUBLIC.OOCKE1_BOOKING B INNER JOIN PUBLIC.OOCKE1_COMPOUNDBOOKING CB ON(B.CB=CB.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_CLFCLASSIFIESTELT (CLASSIFIER,TYPED_ELEMENT) AS SELECT C.OBJECT_ID AS CLASSIFIER,E.OBJECT_ID AS TYPED_ELEMENT FROM PUBLIC.OOCKE1_MODELELEMENT C INNER JOIN PUBLIC.OOCKE1_MODELELEMENT E ON(C.OBJECT_ID=E.TYPE)
CREATE VIEW PUBLIC.OOCKE1_JOIN_CONTACTISMEMBEROF (CONTACT,OU_MEMBERSHIP) AS SELECT CM.CONTACT AS CONTACT,CM.OBJECT_ID AS OU_MEMBERSHIP FROM PUBLIC.OOCKE1_CONTACTMEMBERSHIP CM
CREATE VIEW PUBLIC.OOCKE1_JOIN_CPOSHASPOSMOD ("position",POSITION_MODIFICATION) AS SELECT P.OBJECT_ID AS "position",PM.OBJECT_ID AS POSITION_MODIFICATION FROM PUBLIC.OOCKE1_CONTRACTPOSITION P INNER JOIN PUBLIC.OOCKE1_CONTRACTPOSMOD PM ON(P.OBJECT_ID=PM.INVOLVED)
CREATE VIEW PUBLIC.OOCKE1_JOIN_DEPGCONTAINSDEP (DEPOT,DEPOT_GROUP) AS SELECT D.OBJECT_ID AS DEPOT,DG.OBJECT_ID AS DEPOT_GROUP FROM PUBLIC.OOCKE1_DEPOT D INNER JOIN PUBLIC.OOCKE1_DEPOTGROUP DG ON(D.DEPOT_GROUP=DG.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_DEPGCONTAINSDEPG (DEPOT_GROUP,PARENT) AS SELECT DG.OBJECT_ID AS DEPOT_GROUP,DGP.OBJECT_ID AS PARENT FROM PUBLIC.OOCKE1_DEPOTGROUP DG INNER JOIN PUBLIC.OOCKE1_DEPOTGROUP DGP ON(DG."P$$PARENT"=DGP.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_DEPPOSHASBK (BOOKING,DEPOT_POSITION) AS SELECT B.OBJECT_ID AS BOOKING,B.POSITION AS DEPOT_POSITION FROM PUBLIC.OOCKE1_BOOKING B
CREATE VIEW PUBLIC.OOCKE1_JOIN_DEPPOSHASSBK (SIMPLE_BOOKING,DEPOT_POSITION) AS SELECT B.OBJECT_ID AS SIMPLE_BOOKING,B.POSITION AS DEPOT_POSITION FROM PUBLIC.OOCKE1_SIMPLEBOOKING B
CREATE VIEW PUBLIC.OOCKE1_JOIN_ENTITYCONTAINSDEP (ENTITY,DEPOT) AS SELECT(DH."P$$PARENT")AS ENTITY,D.OBJECT_ID AS DEPOT FROM PUBLIC.OOCKE1_DEPOT D INNER JOIN PUBLIC.OOCKE1_DEPOTHOLDER DH ON(D."P$$PARENT"=DH.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_FLDCONTAINSFLD (FOLDER,PARENT) AS SELECT F.OBJECT_ID AS FOLDER,FP.OBJECT_ID AS PARENT FROM PUBLIC.OOCKE1_DOCUMENTFOLDER F INNER JOIN PUBLIC.OOCKE1_DOCUMENTFOLDER FP ON(F.PARENT=FP.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_HOMEHASASSACT (ASSIGNED_ACTIVITY,USER_HOME) AS SELECT A.OBJECT_ID AS ASSIGNED_ACTIVITY,H0.OBJECT_ID AS USER_HOME FROM PUBLIC.OOCKE1_ACTIVITY A INNER JOIN PUBLIC.OOCKE1_USERHOME H0 ON(A.ASSIGNED_TO=H0.CONTACT)OR(A.REP_CONTACT=H0.CONTACT)OR(A.REP_ACCT=H0.CONTACT)UNION SELECT A.OBJECT_ID AS ASSIGNED_ACTIVITY,H0.OBJECT_ID AS USER_HOME FROM PUBLIC.OOCKE1_ACTIVITY A INNER JOIN PUBLIC.OOCKE1_ADDRESS ADR ON(ADR.OBJECT_ID=A.SENDER)INNER JOIN PUBLIC.OOCKE1_USERHOME H0 ON(ADR."P$$PARENT"=H0.CONTACT)UNION SELECT A.OBJECT_ID AS ASSIGNED_ACTIVITY,H0.OBJECT_ID AS USER_HOME FROM PUBLIC.OOCKE1_ACTIVITYPARTY P0 INNER JOIN PUBLIC.OOCKE1_USERHOME H0 ON(P0.PARTY=H0.CONTACT)INNER JOIN PUBLIC.OOCKE1_ACTIVITY A ON(P0."P$$PARENT"=A.OBJECT_ID)UNION SELECT A.OBJECT_ID AS ASSIGNED_ACTIVITY,H0.OBJECT_ID AS USER_HOME FROM PUBLIC.OOCKE1_ACTIVITYPARTY P0 INNER JOIN PUBLIC.OOCKE1_ACTIVITY A ON(P0."P$$PARENT"=A.OBJECT_ID)INNER JOIN PUBLIC.OOCKE1_ADDRESS ADR ON(ADR.OBJECT_ID=P0.PARTY)INNER JOIN PUBLIC.OOCKE1_USERHOME H0 ON(ADR."P$$PARENT"=H0.CONTACT)
CREATE VIEW PUBLIC.OOCKE1_JOIN_IITEMHASBOOKING (BOOKING,INVENTORY_ITEM) AS SELECT B.OBJECT_ID AS BOOKING,I.OBJECT_ID AS INVENTORY_ITEM FROM PUBLIC.OOCKE1_INVENTORYITEM I INNER JOIN PUBLIC.OOCKE1_BOOKING B ON(B.ORIGIN=I.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_NSCONTAINSELT (NAMESPACE,CONTENT) AS SELECT N.OBJECT_ID AS NAMESPACE,E.OBJECT_ID AS CONTENT FROM PUBLIC.OOCKE1_MODELELEMENT N INNER JOIN PUBLIC.OOCKE1_MODELELEMENT E ON(E.CONTAINER=N.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_RESHASASSIGNEDACT (ASSIGNED_ACTIVITY,RESOURCE) AS SELECT A.OBJECT_ID AS ASSIGNED_ACTIVITY,R.OBJECT_ID AS RESOURCE FROM PUBLIC.OOCKE1_ACTIVITY A INNER JOIN PUBLIC.OOCKE1_RESOURCEASSIGNMENT RA ON(RA."P$$PARENT"=A.OBJECT_ID)INNER JOIN PUBLIC.OOCKE1_RESOURCE R ON(RA.RESRC=R.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_SEGCONTAINSADR (ADDRESS,SEGMENT) AS SELECT ADR.OBJECT_ID AS ADDRESS,ACT."P$$PARENT" AS SEGMENT FROM PUBLIC.OOCKE1_ADDRESS ADR INNER JOIN PUBLIC.OOCKE1_ACCOUNT ACT ON(ADR."P$$PARENT"=ACT.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_SEGCONTAINSFAC (FACILITY,SEGMENT) AS SELECT F.OBJECT_ID AS FACILITY,B."P$$PARENT" AS SEGMENT FROM PUBLIC.OOCKE1_FACILITY F INNER JOIN PUBLIC.OOCKE1_BUILDINGUNIT B ON(F."P$$PARENT"=B.OBJECT_ID)UNION SELECT F.OBJECT_ID AS FACILITY,BU1."P$$PARENT" AS SEGMENT FROM PUBLIC.OOCKE1_FACILITY F INNER JOIN PUBLIC.OOCKE1_BUILDINGUNIT BU2 ON(F."P$$PARENT"=BU2.OBJECT_ID)INNER JOIN PUBLIC.OOCKE1_BUILDINGUNIT BU1 ON(BU2."P$$PARENT"=BU1.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_HOMEHASASSCONTR (ASSIGNED_CONTRACT,USER_HOME) AS SELECT C.OBJECT_ID AS ASSIGNED_CONTRACT,H.OBJECT_ID AS USER_HOME FROM PUBLIC.OOCKE1_CONTRACT C INNER JOIN PUBLIC.OOCKE1_USERHOME H ON(C.SALES_REP=H.CONTACT)UNION SELECT C.OBJECT_ID AS ASSIGNED_CONTRACT,H.OBJECT_ID AS USER_HOME FROM PUBLIC.OOCKE1_CONTRACT C INNER JOIN PUBLIC.OOCKE1_USERHOME H ON(C.CUSTOMER=H.CONTACT)UNION SELECT C.OBJECT_ID AS ASSIGNED_CONTRACT,H.OBJECT_ID AS USER_HOME FROM PUBLIC.OOCKE1_CONTRACT C INNER JOIN PUBLIC.OOCKE1_ACCOUNTASSIGNMENT ASS ON(ASS."P$$PARENT"=C.OBJECT_ID)INNER JOIN PUBLIC.OOCKE1_USERHOME H ON(ASS.ACCOUNT=H.CONTACT)
CREATE VIEW PUBLIC.OOCKE1_JOIN_ACCTHASASSCONTR (ASSIGNED_CONTRACT,ACCOUNT) AS SELECT C.OBJECT_ID AS ASSIGNED_CONTRACT,A.OBJECT_ID AS ACCOUNT FROM PUBLIC.OOCKE1_CONTRACT C INNER JOIN PUBLIC.OOCKE1_ACCOUNT A ON(C.CUSTOMER=A.OBJECT_ID)UNION SELECT C.OBJECT_ID AS ASSIGNED_CONTRACT,A.OBJECT_ID AS ACCOUNT FROM PUBLIC.OOCKE1_CONTRACT C INNER JOIN PUBLIC.OOCKE1_ACCOUNT A ON(C.SALES_REP=A.OBJECT_ID)UNION SELECT C.OBJECT_ID AS ASSIGNED_CONTRACT,A.OBJECT_ID AS ACCOUNT FROM PUBLIC.OOCKE1_CONTRACT C INNER JOIN PUBLIC.OOCKE1_ACCOUNT A ON(C.SUPPLIER=A.OBJECT_ID)UNION SELECT C.OBJECT_ID AS ASSIGNED_CONTRACT,ASS.ACCOUNT AS ACCOUNT FROM PUBLIC.OOCKE1_CONTRACT C INNER JOIN PUBLIC.OOCKE1_ACCOUNTASSIGNMENT ASS ON(ASS."P$$PARENT"=C.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_ACCTHASASSBUDGET (ASSIGNED_BUDGET,ACCOUNT) AS SELECT B.OBJECT_ID AS ASSIGNED_BUDGET,A.OBJECT_ID AS ACCOUNT FROM PUBLIC.OOCKE1_BUDGET B INNER JOIN PUBLIC.OOCKE1_ACCOUNT A ON B.ACCOUNT=A.OBJECT_ID UNION SELECT B.OBJECT_ID AS ASSIGNED_BUDGET,ASS.ACCOUNT AS ACCOUNT FROM PUBLIC.OOCKE1_BUDGET B INNER JOIN PUBLIC.OOCKE1_ACCOUNTASSIGNMENT ASS ON ASS."P$$PARENT"=B.OBJECT_ID
CREATE VIEW PUBLIC.OOCKE1_JOIN_BUHASADR (ASSIGNED_ADDRESS,BUILDING_UNIT) AS SELECT ADR.OBJECT_ID AS ASSIGNED_ADDRESS,BU.OBJECT_ID AS BUILDING_UNIT FROM PUBLIC.OOCKE1_ADDRESS ADR INNER JOIN PUBLIC.OOCKE1_BUILDINGUNIT BU ON(ADR.BUILDING=BU.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_SEGCONTAINSBU (BUILDING_UNIT,SEGMENT) AS SELECT B.OBJECT_ID AS BUILDING_UNIT,S.OBJECT_ID AS SEGMENT FROM PUBLIC.OOCKE1_BUILDINGUNIT B INNER JOIN PUBLIC.OOCKE1_SEGMENT S ON(B."P$$PARENT"=S.OBJECT_ID)UNION SELECT B.OBJECT_ID AS BUILDING_UNIT,BP."P$$PARENT" AS SEGMENT FROM PUBLIC.OOCKE1_BUILDINGUNIT B INNER JOIN PUBLIC.OOCKE1_BUILDINGUNIT BP ON(B."P$$PARENT"=BP.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_ACTGISCREATEDBY (ACTIVITY_GROUP,ACTIVITY_CREATOR) AS SELECT AC.ACTIVITY_GROUP AS ACTIVITY_GROUP,AC.OBJECT_ID AS ACTIVITY_CREATOR FROM PUBLIC.OOCKE1_ACTIVITYCREATOR_ AC
CREATE VIEW PUBLIC.OOCKE1_JOIN_DEPREPITMHASBK (ITEM_POSITION,SINGLE_BOOKING) AS SELECT IP.OBJECT_ID AS ITEM_POSITION,B.OBJECT_ID AS SINGLE_BOOKING FROM PUBLIC.OOCKE1_DEPOTREPORTITEM IP INNER JOIN PUBLIC.OOCKE1_DEPOTREPORT R ON(IP."P$$PARENT"=R.OBJECT_ID)INNER JOIN PUBLIC.OOCKE1_BOOKINGPERIOD BP ON(R.BOOKING_PERIOD=BP.OBJECT_ID)INNER JOIN PUBLIC.OOCKE1_BOOKING B ON(B.POSITION=IP.POSITION)AND(B.VALUE_DATE>=BP.PERIOD_STARTS_AT)AND((B.VALUE_DATE<BP.PERIOD_ENDS_AT_EXCLUSIVE)OR(BP.PERIOD_ENDS_AT_EXCLUSIVE IS NULL))AND((B.BOOKING_STATUS>=R.BOOKING_STATUS_THRESHOLD)OR(R.BOOKING_STATUS_THRESHOLD=0)OR(R.BOOKING_STATUS_THRESHOLD IS NULL))
CREATE VIEW PUBLIC.OOCKE1_JOIN_DEPREPITMHASSBK (ITEM_POSITION,SIMPLE_BOOKING) AS SELECT IP.OBJECT_ID AS ITEM_POSITION,B.OBJECT_ID AS SIMPLE_BOOKING FROM PUBLIC.OOCKE1_DEPOTREPORTITEM IP INNER JOIN PUBLIC.OOCKE1_DEPOTREPORT R ON(IP."P$$PARENT"=R.OBJECT_ID)INNER JOIN PUBLIC.OOCKE1_BOOKINGPERIOD BP ON(R.BOOKING_PERIOD=BP.OBJECT_ID)INNER JOIN PUBLIC.OOCKE1_SIMPLEBOOKING B ON(B.POSITION=IP.POSITION)AND(B.VALUE_DATE>=BP.PERIOD_STARTS_AT)AND((B.VALUE_DATE<BP.PERIOD_ENDS_AT_EXCLUSIVE)OR(BP.PERIOD_ENDS_AT_EXCLUSIVE IS NULL))AND((B.BOOKING_STATUS>=R.BOOKING_STATUS_THRESHOLD)OR(R.BOOKING_STATUS_THRESHOLD=0)OR(R.BOOKING_STATUS_THRESHOLD IS NULL))
CREATE VIEW PUBLIC.OOCKE1_JOIN_FILTERINCLDESCONTR (CONTRACT_FILTER,FILTERED_CONTRACT) AS SELECT F.OBJECT_ID AS CONTRACT_FILTER,C.OBJECT_ID AS FILTERED_CONTRACT FROM PUBLIC.OOCKE1_FILTER F INNER JOIN PUBLIC.OOCKE1_CONTRACT C ON(1=1)
CREATE VIEW PUBLIC.OOCKE1_JOIN_ACTGCONTAINSWRE (ACTIVITY_GROUP,WORK_REPORT_ENTRY) AS SELECT GA.ACTIVITY_GROUP AS ACTIVITY_GROUP,WR.OBJECT_ID AS WORK_REPORT_ENTRY FROM PUBLIC.OOCKE1_WORKRECORD WR INNER JOIN PUBLIC.OOCKE1_RESOURCEASSIGNMENT RA ON(WR."P$$PARENT"=RA.OBJECT_ID)INNER JOIN PUBLIC.OOCKE1_ACTIVITYGROUPASS GA ON(GA."P$$PARENT"=RA."P$$PARENT")
CREATE VIEW PUBLIC.OOCKE1_JOIN_ACTCONTAINSWRE (ACTIVITY,WORK_REPORT_ENTRY) AS SELECT(RA."P$$PARENT")AS ACTIVITY,WR.OBJECT_ID AS WORK_REPORT_ENTRY FROM PUBLIC.OOCKE1_WORKRECORD WR INNER JOIN PUBLIC.OOCKE1_RESOURCEASSIGNMENT RA ON(WR."P$$PARENT"=RA.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_SEGCONTAINSWRE (SEGMENT,WORK_REPORT_ENTRY) AS SELECT(A."P$$PARENT")AS SEGMENT,WR.OBJECT_ID AS WORK_REPORT_ENTRY FROM PUBLIC.OOCKE1_WORKRECORD WR INNER JOIN PUBLIC.OOCKE1_RESOURCEASSIGNMENT RA ON(WR."P$$PARENT"=RA.OBJECT_ID)INNER JOIN PUBLIC.OOCKE1_ACTIVITY A ON(RA."P$$PARENT"=A.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_RESCONTAINSWRE (RESOURCE,WORK_REPORT_ENTRY) AS SELECT RA.RESRC AS RESOURCE,WR.OBJECT_ID AS WORK_REPORT_ENTRY FROM PUBLIC.OOCKE1_WORKRECORD WR INNER JOIN PUBLIC.OOCKE1_RESOURCEASSIGNMENT RA ON(WR."P$$PARENT"=RA.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_TOBJ_ACTIVITYLINKFROM (OBJECT_ID,"P$$PARENT",DTYPE,MODIFIED_AT,CREATED_AT,CREATED_BY_,MODIFIED_BY_,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_UPDATE,ACCESS_LEVEL_DELETE,OWNER_,ACTIVITY_LINK_TYPE,"NAME",DESCRIPTION,LINK_FROM,LINK_TO) AS SELECT REPLACE(A.OBJECT_ID,'/','*')||'*'||REPLACE(L.OBJECT_ID,'/','*')AS OBJECT_ID,A.OBJECT_ID AS "P$$PARENT",'org:opencrx:kernel:activity1:ActivityLinkFrom'AS DTYPE,L.MODIFIED_AT,L.CREATED_AT,L.CREATED_BY_,L.MODIFIED_BY_,L.ACCESS_LEVEL_BROWSE,L.ACCESS_LEVEL_UPDATE,L.ACCESS_LEVEL_DELETE,L.OWNER_,100-L.ACTIVITY_LINK_TYPE AS ACTIVITY_LINK_TYPE,L.NAME,L.DESCRIPTION,L."P$$PARENT" AS LINK_FROM,L.OBJECT_ID AS LINK_TO FROM PUBLIC.OOCKE1_ACTIVITYLINK L INNER JOIN PUBLIC.OOCKE1_ACTIVITY A ON L.LINK_TO=A.OBJECT_ID
CREATE VIEW PUBLIC.OOCKE1_TOBJ_ACTIVITYLINKFROM_ (OBJECT_ID,"P$$PARENT",IDX,CREATED_BY,MODIFIED_BY,OWNER,DTYPE) AS SELECT L_.OBJECT_ID,L."P$$PARENT",L_.IDX,L_.CREATED_BY,L_.MODIFIED_BY,L_.OWNER,L_.DTYPE FROM PUBLIC.OOCKE1_ACTIVITYLINK_ L_ INNER JOIN PUBLIC.OOCKE1_ACTIVITYLINK L ON L.OBJECT_ID=L_.OBJECT_ID
CREATE VIEW PUBLIC.OOCKE1_TOBJ_CONTRACTLNKFROM (OBJECT_ID,"P$$PARENT",DTYPE,MODIFIED_AT,CREATED_AT,CREATED_BY_,MODIFIED_BY_,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_UPDATE,ACCESS_LEVEL_DELETE,OWNER_,LINK_TYPE,"NAME",DESCRIPTION,VALID_FROM,VALID_TO,LINK_FROM,LINK_TO) AS SELECT REPLACE(C.OBJECT_ID,'/','*')||'*'||REPLACE(L.OBJECT_ID,'/','*')AS OBJECT_ID,C.OBJECT_ID AS "P$$PARENT",'org:opencrx:kernel:contract1:ContractLinkFrom'AS DTYPE,L.MODIFIED_AT,L.CREATED_AT,L.CREATED_BY_,L.MODIFIED_BY_,L.ACCESS_LEVEL_BROWSE,L.ACCESS_LEVEL_UPDATE,L.ACCESS_LEVEL_DELETE,L.OWNER_,100-L.LINK_TYPE AS LINK_TYPE,L.NAME,L.DESCRIPTION,L.VALID_FROM AS VALID_FROM,L.VALID_TO AS VALID_TO,L."P$$PARENT" AS LINK_FROM,L.OBJECT_ID AS LINK_TO FROM PUBLIC.OOCKE1_CONTRACTLINK L INNER JOIN PUBLIC.OOCKE1_CONTRACT C ON L.LINK_TO=C.OBJECT_ID
CREATE VIEW PUBLIC.OOCKE1_TOBJ_CONTRACTLNKFROM_ (OBJECT_ID,"P$$PARENT",IDX,CREATED_BY,MODIFIED_BY,OWNER,DTYPE) AS SELECT L_.OBJECT_ID,L."P$$PARENT",L_.IDX,L_.CREATED_BY,L_.MODIFIED_BY,L_.OWNER,L_.DTYPE FROM PUBLIC.OOCKE1_CONTRACTLINK_ L_ INNER JOIN PUBLIC.OOCKE1_CONTRACTLINK L ON L.OBJECT_ID=L_.OBJECT_ID
CREATE VIEW PUBLIC.OOCKE1_TOBJ_CONTRACTROLE (OBJECT_ID,"P$$PARENT",DTYPE,MODIFIED_AT,MODIFIED_BY_,CREATED_AT,CREATED_BY_,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_UPDATE,ACCESS_LEVEL_DELETE,OWNER_,ACCOUNT,CONTRACT_REFERENCE_HOLDER,CONTRACT) AS SELECT REPLACE(C."P$$PARENT",'/','*')||'*'||REPLACE(DHN.OBJECT_ID,'/','*')||'*'||REPLACE(C.OBJECT_ID,'/','*')AS OBJECT_ID,C."P$$PARENT" AS "P$$PARENT",'org:opencrx:kernel:contract1:CustomerContractRole'AS DTYPE,C.MODIFIED_AT,C.MODIFIED_BY_,C.CREATED_AT,C.CREATED_BY_,C.ACCESS_LEVEL_BROWSE,C.ACCESS_LEVEL_UPDATE,C.ACCESS_LEVEL_DELETE,C.OWNER_,C.CUSTOMER AS ACCOUNT,DHN.OBJECT_ID AS CONTRACT_REFERENCE_HOLDER,DHN.CONTRACT FROM PUBLIC.OOCKE1_DEPOTHOLDER_ DHN INNER JOIN PUBLIC.OOCKE1_CONTRACT C ON(C.OBJECT_ID=DHN.CONTRACT)INNER JOIN PUBLIC.OOCKE1_ACCOUNT A ON(C.CUSTOMER=A.OBJECT_ID)UNION ALL SELECT REPLACE(C."P$$PARENT",'contracts/','contractRole/')||'/'||REPLACE(DGN.OBJECT_ID,'/','-')||'-'||REPLACE(C.OBJECT_ID,'/','-')AS OBJECT_ID,C."P$$PARENT" AS "P$$PARENT",'org:opencrx:kernel:contract1:CustomerContractRole'AS DTYPE,C.MODIFIED_AT,C.MODIFIED_BY_,C.CREATED_AT,C.CREATED_BY_,C.ACCESS_LEVEL_BROWSE,C.ACCESS_LEVEL_UPDATE,C.ACCESS_LEVEL_DELETE,C.OWNER_,C.CUSTOMER AS ACCOUNT,DGN.OBJECT_ID AS CONTRACT_REFERENCE_HOLDER,DGN.CONTRACT FROM PUBLIC.OOCKE1_DEPOTGROUP_ DGN INNER JOIN PUBLIC.OOCKE1_CONTRACT C ON(C.OBJECT_ID=DGN.CONTRACT)INNER JOIN PUBLIC.OOCKE1_ACCOUNT A ON(C.CUSTOMER=A.OBJECT_ID)UNION ALL SELECT REPLACE(C."P$$PARENT",'contracts/','contractRole/')||'/'||REPLACE(DN.OBJECT_ID,'/','-')||'-'||REPLACE(C.OBJECT_ID,'/','-')AS OBJECT_ID,C."P$$PARENT" AS "P$$PARENT",'org:opencrx:kernel:contract1:CustomerContractRole'AS DTYPE,C.MODIFIED_AT,C.MODIFIED_BY_,C.CREATED_AT,C.CREATED_BY_,C.ACCESS_LEVEL_BROWSE,C.ACCESS_LEVEL_UPDATE,C.ACCESS_LEVEL_DELETE,C.OWNER_,C.CUSTOMER AS ACCOUNT,DN.OBJECT_ID AS CONTRACT_REFERENCE_HOLDER,DN.CONTRACT FROM PUBLIC.OOCKE1_DEPOT_ DN INNER JOIN PUBLIC.OOCKE1_CONTRACT C ON(C.OBJECT_ID=DN.CONTRACT)INNER JOIN PUBLIC.OOCKE1_ACCOUNT A ON(C.CUSTOMER=A.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_TOBJ_CONTRACTROLE_ (OBJECT_ID,"P$$PARENT",IDX,CREATED_BY,MODIFIED_BY,OWNER,DTYPE) AS SELECT C_.OBJECT_ID,C."P$$PARENT",C_.IDX,C_.CREATED_BY,C_.MODIFIED_BY,C_.OWNER,'org:opencrx:kernel:contract1:CustomerContractRole'AS DTYPE FROM PUBLIC.OOCKE1_CONTRACT_ C_ INNER JOIN PUBLIC.OOCKE1_CONTRACT C ON C_.OBJECT_ID=C.OBJECT_ID
CREATE VIEW PUBLIC.OOCKE1_TOBJ_DOCFLDENTRY (OBJECT_ID,"P$$PARENT",DTYPE,MODIFIED_AT,MODIFIED_BY_,CREATED_AT,CREATED_BY_,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_UPDATE,ACCESS_LEVEL_DELETE,OWNER_,NAME,DESCRIPTION,VALID_FROM,VALID_TO,DISABLED,ASSIGNMENT_ROLE,DOCUMENT,BASED_ON) AS SELECT REPLACE(D_.FOLDER,'/','*')||'*'||REPLACE(D.OBJECT_ID,'/','*')AS OBJECT_ID,D_.FOLDER AS "P$$PARENT",'org:opencrx:kernel:document1:DocumentBasedFolderEntry'AS DTYPE,D.MODIFIED_AT,D.MODIFIED_BY_,D.CREATED_AT,D.CREATED_BY_,D.ACCESS_LEVEL_BROWSE,D.ACCESS_LEVEL_UPDATE,D.ACCESS_LEVEL_DELETE,D.OWNER_,D.NAME AS NAME,D.DESCRIPTION AS DESCRIPTION,D.ACTIVE_ON AS VALID_FROM,D.ACTIVE_UNTIL AS VALID_TO,D.DISABLED AS DISABLED,0 AS ASSIGNMENT_ROLE,D.OBJECT_ID AS DOCUMENT,D.OBJECT_ID AS BASED_ON FROM PUBLIC.OOCKE1_DOCUMENT_ D_ INNER JOIN PUBLIC.OOCKE1_DOCUMENT D ON(D_.OBJECT_ID=D.OBJECT_ID)AND(D_.FOLDER IS NOT NULL)UNION SELECT REPLACE(DFA.DOCUMENT_FOLDER,'/','*')||'*'||REPLACE(DFA.OBJECT_ID,'/','*')AS OBJECT_ID,DFA.DOCUMENT_FOLDER AS "P$$PARENT",'org:opencrx:kernel:document1:AssignmentBasedFolderEntry'AS DTYPE,DFA.MODIFIED_AT,DFA.MODIFIED_BY_,DFA.CREATED_AT,DFA.CREATED_BY_,DFA.ACCESS_LEVEL_BROWSE,DFA.ACCESS_LEVEL_UPDATE,DFA.ACCESS_LEVEL_DELETE,DFA.OWNER_,DFA.NAME AS NAME,DFA.DESCRIPTION AS DESCRIPTION,DFA.VALID_FROM AS VALID_FROM,DFA.VALID_TO AS VALID_TO,DFA.DISABLED AS DISABLED,DFA.ASSIGNMENT_ROLE AS ASSIGNMENT_ROLE,DFA."P$$PARENT" AS DOCUMENT,DFA.OBJECT_ID AS BASED_ON FROM PUBLIC.OOCKE1_DOCUMENTFOLDERASS DFA WHERE DFA.DOCUMENT_FOLDER IS NOT NULL
CREATE VIEW PUBLIC.OOCKE1_TOBJ_DOCFLDENTRY_ (OBJECT_ID,"P$$PARENT",IDX,CREATED_BY,MODIFIED_BY,OWNER,DTYPE) AS SELECT D_.OBJECT_ID,F.FOLDER AS "P$$PARENT",D_.IDX,D_.CREATED_BY,D_.MODIFIED_BY,D_.OWNER,'org:opencrx:kernel:document1:DocumentBasedFolderEntry'AS DTYPE FROM PUBLIC.OOCKE1_DOCUMENT_ D_ INNER JOIN PUBLIC.OOCKE1_DOCUMENT_ F ON D_.OBJECT_ID=F.OBJECT_ID WHERE F.FOLDER IS NOT NULL UNION SELECT DFA_.OBJECT_ID,DFA.DOCUMENT_FOLDER AS "P$$PARENT",DFA_.IDX,DFA_.CREATED_BY,DFA_.MODIFIED_BY,DFA_.OWNER,'org:opencrx:kernel:document1:AssignmentBasedFolderEntry'AS DTYPE FROM PUBLIC.OOCKE1_DOCUMENTFOLDERASS_ DFA_ INNER JOIN PUBLIC.OOCKE1_DOCUMENTFOLDERASS DFA ON DFA_.OBJECT_ID=DFA.OBJECT_ID
CREATE VIEW PUBLIC.OOCKE1_TOBJ_ACCTMEMBERSHIP_D1 (ACCOUNT,"P$$PARENT") AS SELECT ASS.ACCOUNT AS ACCOUNT,ASS."P$$PARENT" AS "P$$PARENT" FROM PUBLIC.OOCKE1_ACCOUNTASSIGNMENT ASS UNION SELECT(ASS."P$$PARENT")AS ACCOUNT,ASS.ACCOUNT AS "P$$PARENT" FROM PUBLIC.OOCKE1_ACCOUNTASSIGNMENT ASS
CREATE VIEW PUBLIC.OOCKE1_TOBJ_ACCTMEMBERSHIP_D2 (ACCOUNT,"P$$PARENT") AS SELECT(ASS0."P$$PARENT")AS ACCOUNT,ASS."P$$PARENT" AS "P$$PARENT" FROM PUBLIC.OOCKE1_ACCOUNTASSIGNMENT ASS0 INNER JOIN PUBLIC.OOCKE1_TOBJ_ACCTMEMBERSHIP_D1 ASS ON(ASS0.ACCOUNT=ASS.ACCOUNT)UNION SELECT(ASS0.ACCOUNT)AS ACCOUNT,ASS."P$$PARENT" AS "P$$PARENT" FROM PUBLIC.OOCKE1_ACCOUNTASSIGNMENT ASS0 INNER JOIN PUBLIC.OOCKE1_TOBJ_ACCTMEMBERSHIP_D1 ASS ON(ASS0."P$$PARENT"=ASS.ACCOUNT)
CREATE VIEW PUBLIC.OOCKE1_TOBJ_ACCTMEMBERSHIP_D3 (ACCOUNT,"P$$PARENT") AS SELECT(ASS0."P$$PARENT")AS ACCOUNT,ASS."P$$PARENT" AS "P$$PARENT" FROM PUBLIC.OOCKE1_ACCOUNTASSIGNMENT ASS0 INNER JOIN PUBLIC.OOCKE1_TOBJ_ACCTMEMBERSHIP_D2 ASS ON(ASS0.ACCOUNT=ASS.ACCOUNT)UNION SELECT ASS0.ACCOUNT AS ACCOUNT,ASS."P$$PARENT" AS "P$$PARENT" FROM PUBLIC.OOCKE1_ACCOUNTASSIGNMENT ASS0 INNER JOIN PUBLIC.OOCKE1_TOBJ_ACCTMEMBERSHIP_D2 ASS ON(ASS0."P$$PARENT"=ASS.ACCOUNT)
CREATE VIEW PUBLIC.OOCKE1_TOBJ_ACCTMEMBERSHIP_D4 (ACCOUNT,"P$$PARENT") AS SELECT(ASS0."P$$PARENT")AS ACCOUNT,ASS."P$$PARENT" AS "P$$PARENT" FROM PUBLIC.OOCKE1_ACCOUNTASSIGNMENT ASS0 INNER JOIN PUBLIC.OOCKE1_TOBJ_ACCTMEMBERSHIP_D3 ASS ON(ASS0.ACCOUNT=ASS.ACCOUNT)UNION SELECT ASS0.ACCOUNT AS ACCOUNT,ASS."P$$PARENT" AS "P$$PARENT" FROM PUBLIC.OOCKE1_ACCOUNTASSIGNMENT ASS0 INNER JOIN PUBLIC.OOCKE1_TOBJ_ACCTMEMBERSHIP_D3 ASS ON(ASS0."P$$PARENT"=ASS.ACCOUNT)
CREATE VIEW PUBLIC.OOCKE1_TOBJ_ACCTMEMBERSHIP1 (OBJECT_ID,"P$$PARENT",ACCOUNT_FROM,ACCOUNT_FROM_ID,ACCOUNT_TO,ACCOUNT_TO_ID,CREATED_AT,CREATED_BY_,MODIFIED_AT,MODIFIED_BY_,DTYPE,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_UPDATE,ACCESS_LEVEL_DELETE,OWNER_,"NAME",DESCRIPTION,QUALITY,FOR_USE_BY_,VALID_FROM,VALID_TO,MEMBER,DISABLED,MEMBER_ROLE_0,MEMBER_ROLE_1,MEMBER_ROLE_2,MEMBER_ROLE_3,MEMBER_ROLE_4,USER_BOOLEAN0,USER_BOOLEAN1,USER_BOOLEAN2,USER_BOOLEAN3,USER_BOOLEAN4_,USER_CODE0,USER_CODE1,USER_CODE2,USER_CODE3,USER_CODE4_,USER_DATE0,USER_DATE1,USER_DATE2,USER_DATE3,USER_DATE4_,USER_DATE_TIME0,USER_DATE_TIME1,USER_DATE_TIME2,USER_DATE_TIME3,USER_DATE_TIME4_,USER_NUMBER0,USER_NUMBER1,USER_NUMBER2,USER_NUMBER3,USER_NUMBER4_,USER_STRING0,USER_STRING1,USER_STRING2,USER_STRING3,USER_STRING4_,DISTANCE) AS SELECT DISTINCT REPLACE(ASS0."P$$PARENT",'/','*')||'*'||REPLACE(ASS0.OBJECT_ID,'/','*')||'*1'AS OBJECT_ID,ASS0."P$$PARENT" AS "P$$PARENT",ASS0."P$$PARENT" AS ACCOUNT_FROM,ASS0."P$$PARENT" AS ACCOUNT_FROM_ID,ASS0.ACCOUNT AS ACCOUNT_TO,ASS0.ACCOUNT AS ACCOUNT_TO_ID,ASS0.MODIFIED_AT AS CREATED_AT,ASS0.CREATED_BY_,CASE WHEN ASS0.MODIFIED_AT>ACCT.MODIFIED_AT THEN ASS0.MODIFIED_AT ELSE ACCT.MODIFIED_AT END AS MODIFIED_AT,ASS0.MODIFIED_BY_,REPLACE(ASS0.DTYPE,'Member','AccountMembership')AS DTYPE,ASS0.ACCESS_LEVEL_BROWSE,ASS0.ACCESS_LEVEL_UPDATE,ASS0.ACCESS_LEVEL_DELETE,ASS0.OWNER_,ASS0.NAME,ASS0.DESCRIPTION,ASS0.QUALITY,ASS0.FOR_USE_BY_,ASS0.VALID_FROM,ASS0.VALID_TO,ASS0.OBJECT_ID AS MEMBER,ASS0.DISABLED,ASS0.MEMBER_ROLE_0,ASS0.MEMBER_ROLE_1,ASS0.MEMBER_ROLE_2,ASS0.MEMBER_ROLE_3,ASS0.MEMBER_ROLE_4,ASS0.USER_BOOLEAN0,ASS0.USER_BOOLEAN1,ASS0.USER_BOOLEAN2,ASS0.USER_BOOLEAN3,ASS0.USER_BOOLEAN4_,ASS0.USER_CODE0,ASS0.USER_CODE1,ASS0.USER_CODE2,ASS0.USER_CODE3,ASS0.USER_CODE4_,ASS0.USER_DATE0,ASS0.USER_DATE1,ASS0.USER_DATE2,ASS0.USER_DATE3,ASS0.USER_DATE4_,ASS0.USER_DATE_TIME0,ASS0.USER_DATE_TIME1,ASS0.USER_DATE_TIME2,ASS0.USER_DATE_TIME3,ASS0.USER_DATE_TIME4_,ASS0.USER_NUMBER0,ASS0.USER_NUMBER1,ASS0.USER_NUMBER2,ASS0.USER_NUMBER3,ASS0.USER_NUMBER4_,ASS0.USER_STRING0,ASS0.USER_STRING1,ASS0.USER_STRING2,ASS0.USER_STRING3,ASS0.USER_STRING4_,1 AS DISTANCE FROM PUBLIC.OOCKE1_ACCOUNTASSIGNMENT ASS0 INNER JOIN PUBLIC.OOCKE1_ACCOUNT ACCT ON ASS0.ACCOUNT=ACCT.OBJECT_ID WHERE ASS0."P$$PARENT" LIKE'account/%'UNION ALL SELECT DISTINCT REPLACE(ASS0.ACCOUNT,'/','*')||'*'||REPLACE(ASS0.OBJECT_ID,'/','*')||'*-1'AS OBJECT_ID,ASS0.ACCOUNT AS "P$$PARENT",ASS0."P$$PARENT" AS ACCOUNT_FROM,ASS0."P$$PARENT" AS ACCOUNT_FROM_ID,ASS0.ACCOUNT AS ACCOUNT_TO,ASS0.ACCOUNT AS ACCOUNT_TO_ID,ASS0.MODIFIED_AT AS CREATED_AT,ASS0.CREATED_BY_,CASE WHEN ASS0.MODIFIED_AT>ACCT.MODIFIED_AT THEN ASS0.MODIFIED_AT ELSE ACCT.MODIFIED_AT END AS MODIFIED_AT,ASS0.MODIFIED_BY_,REPLACE(ASS0.DTYPE,'Member','AccountMembership')AS DTYPE,ASS0.ACCESS_LEVEL_BROWSE,ASS0.ACCESS_LEVEL_UPDATE,ASS0.ACCESS_LEVEL_DELETE,ASS0.OWNER_,ASS0.NAME,ASS0.DESCRIPTION,ASS0.QUALITY,ASS0.FOR_USE_BY_,ASS0.VALID_FROM,ASS0.VALID_TO,ASS0.OBJECT_ID AS MEMBER,ASS0.DISABLED,ASS0.MEMBER_ROLE_0,ASS0.MEMBER_ROLE_1,ASS0.MEMBER_ROLE_2,ASS0.MEMBER_ROLE_3,ASS0.MEMBER_ROLE_4,ASS0.USER_BOOLEAN0,ASS0.USER_BOOLEAN1,ASS0.USER_BOOLEAN2,ASS0.USER_BOOLEAN3,ASS0.USER_BOOLEAN4_,ASS0.USER_CODE0,ASS0.USER_CODE1,ASS0.USER_CODE2,ASS0.USER_CODE3,ASS0.USER_CODE4_,ASS0.USER_DATE0,ASS0.USER_DATE1,ASS0.USER_DATE2,ASS0.USER_DATE3,ASS0.USER_DATE4_,ASS0.USER_DATE_TIME0,ASS0.USER_DATE_TIME1,ASS0.USER_DATE_TIME2,ASS0.USER_DATE_TIME3,ASS0.USER_DATE_TIME4_,ASS0.USER_NUMBER0,ASS0.USER_NUMBER1,ASS0.USER_NUMBER2,ASS0.USER_NUMBER3,ASS0.USER_NUMBER4_,ASS0.USER_STRING0,ASS0.USER_STRING1,ASS0.USER_STRING2,ASS0.USER_STRING3,ASS0.USER_STRING4_,-1 AS DISTANCE FROM PUBLIC.OOCKE1_ACCOUNTASSIGNMENT ASS0 INNER JOIN PUBLIC.OOCKE1_ACCOUNT ACCT ON ASS0.ACCOUNT=ACCT.OBJECT_ID WHERE ASS0."P$$PARENT" LIKE'account/%'
CREATE VIEW PUBLIC.OOCKE1_TOBJ_ACCTMEMBERSHIP_ (OBJECT_ID,"P$$PARENT",IDX,CREATED_BY,MODIFIED_BY,OWNER,DTYPE,FOR_USE_BY,USER_BOOLEAN4,USER_CODE4,USER_DATE4,USER_DATE_TIME4,USER_NUMBER4,USER_STRING4) AS SELECT ASS_.OBJECT_ID,ASS."P$$PARENT",ASS_.IDX,ASS_.CREATED_BY,ASS_.MODIFIED_BY,ASS_.OWNER,ASS_.DTYPE,ASS_.FOR_USE_BY,ASS_.USER_BOOLEAN4,ASS_.USER_CODE4,ASS_.USER_DATE4,ASS_.USER_DATE_TIME4,ASS_.USER_NUMBER4,ASS_.USER_STRING4 FROM PUBLIC.OOCKE1_ACCOUNTASSIGNMENT_ ASS_ INNER JOIN PUBLIC.OOCKE1_ACCOUNTASSIGNMENT ASS ON(ASS_.OBJECT_ID=ASS.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_TOBJ_LNKITEMLNKFROM (OBJECT_ID,"P$$PARENT",CREATED_AT,CREATED_BY_,MODIFIED_AT,MODIFIED_BY_,DTYPE,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_UPDATE,ACCESS_LEVEL_DELETE,OWNER_,DISABLED,DISABLED_REASON,"NAME",DESCRIPTION,LINK_TYPE,VALID_FROM,VALID_TO,LINK_TO,LINK_FROM) AS SELECT REPLACE(L.LINK_TO,'/','*')||'*'||REPLACE(L.OBJECT_ID,'/','*')AS OBJECT_ID,L.LINK_TO AS "P$$PARENT",L.CREATED_AT,L.CREATED_BY_,L.MODIFIED_AT,L.MODIFIED_BY_,'org:opencrx:kernel:building1:LinkableItemLinkFrom'AS DTYPE,L.ACCESS_LEVEL_BROWSE,L.ACCESS_LEVEL_UPDATE,L.ACCESS_LEVEL_DELETE,L.OWNER_,L.DISABLED,L.DISABLED_REASON,L.NAME,L.DESCRIPTION,100-L.LINK_TYPE AS LINK_TYPE,L.VALID_FROM,L.VALID_TO,L.OBJECT_ID AS LINK_TO,L."P$$PARENT" AS LINK_FROM FROM PUBLIC.OOCKE1_LINKABLEITEMLINK L WHERE L.LINK_TO LIKE'facility/%'UNION ALL SELECT REPLACE(L.LINK_TO,'/','*')||'*'||REPLACE(L.OBJECT_ID,'/','*')AS OBJECT_ID,L.LINK_TO AS "P$$PARENT",L.CREATED_AT,L.CREATED_BY_,L.MODIFIED_AT,L.MODIFIED_BY_,'org:opencrx:kernel:building1:LinkableItemLinkFrom'AS DTYPE,L.ACCESS_LEVEL_BROWSE,L.ACCESS_LEVEL_UPDATE,L.ACCESS_LEVEL_DELETE,L.OWNER_,L.DISABLED,L.DISABLED_REASON,L.NAME,L.DESCRIPTION,100-L.LINK_TYPE AS LINK_TYPE,L.VALID_FROM,L.VALID_TO,L.OBJECT_ID AS LINK_TO,L."P$$PARENT" AS LINK_FROM FROM PUBLIC.OOCKE1_LINKABLEITEMLINK L WHERE L.LINK_TO LIKE'facility1/%'UNION ALL SELECT REPLACE(L.LINK_TO,'/','*')||'*'||REPLACE(L.OBJECT_ID,'/','*')AS OBJECT_ID,L.LINK_TO AS "P$$PARENT",L.CREATED_AT,L.CREATED_BY_,L.MODIFIED_AT,L.MODIFIED_BY_,'org:opencrx:kernel:building1:LinkableItemLinkFrom'AS DTYPE,L.ACCESS_LEVEL_BROWSE,L.ACCESS_LEVEL_UPDATE,L.ACCESS_LEVEL_DELETE,L.OWNER_,L.DISABLED,L.DISABLED_REASON,L.NAME,L.DESCRIPTION,100-L.LINK_TYPE AS LINK_TYPE,L.VALID_FROM,L.VALID_TO,L.OBJECT_ID AS LINK_TO,L."P$$PARENT" AS LINK_FROM FROM PUBLIC.OOCKE1_LINKABLEITEMLINK L WHERE L.LINK_TO LIKE'facility2/%'UNION ALL SELECT REPLACE(L.LINK_TO,'/','*')||'*'||REPLACE(L.OBJECT_ID,'/','*')AS OBJECT_ID,L.LINK_TO AS "P$$PARENT",L.CREATED_AT,L.CREATED_BY_,L.MODIFIED_AT,L.MODIFIED_BY_,'org:opencrx:kernel:building1:LinkableItemLinkFrom'AS DTYPE,L.ACCESS_LEVEL_BROWSE,L.ACCESS_LEVEL_UPDATE,L.ACCESS_LEVEL_DELETE,L.OWNER_,L.DISABLED,L.DISABLED_REASON,L.NAME,L.DESCRIPTION,100-L.LINK_TYPE AS LINK_TYPE,L.VALID_FROM,L.VALID_TO,L.OBJECT_ID AS LINK_TO,L."P$$PARENT" AS LINK_FROM FROM PUBLIC.OOCKE1_LINKABLEITEMLINK L WHERE L.LINK_TO LIKE'inventoryItem/%'
CREATE VIEW PUBLIC.OOCKE1_TOBJ_LNKITEMLNKFROM_ (OBJECT_ID,"P$$PARENT",IDX,CREATED_BY,MODIFIED_BY,OWNER,DTYPE) AS SELECT L_.OBJECT_ID,L."P$$PARENT",L_.IDX,L_.CREATED_BY,L_.MODIFIED_BY,L_.OWNER,L_.DTYPE FROM PUBLIC.OOCKE1_LINKABLEITEMLINK_ L_ INNER JOIN PUBLIC.OOCKE1_LINKABLEITEMLINK L ON L_.OBJECT_ID=L.OBJECT_ID
CREATE VIEW PUBLIC.OOCKE1_TOBJ_PRICELISTENTRY (OBJECT_ID,"P$$PARENT",DTYPE,MODIFIED_AT,MODIFIED_BY_,CREATED_AT,CREATED_BY_,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_UPDATE,ACCESS_LEVEL_DELETE,OWNER_,OBJUSAGE_,PRICE,PRICE_CURRENCY,PRICE_LEVEL_,DESCRIPTION,QUANTITY_FROM,QUANTITY_TO,DISCOUNT,DISCOUNT_IS_PERCENTAGE,UOM,PRODUCT_NAME,PRODUCT_DESCRIPTION,PRODUCT_DISABLED,PRODUCT,SALES_TAX_TYPE,BASE_PRICE) AS SELECT REPLACE(BP.OBJECT_ID,'/','*')AS OBJECT_ID,P."P$$PARENT" AS "P$$PARENT",'org:opencrx:kernel:product1:PriceListEntry'AS DTYPE,BP.MODIFIED_AT,BP.MODIFIED_BY_,BP.CREATED_AT,BP.CREATED_BY_,BP.ACCESS_LEVEL_BROWSE,BP.ACCESS_LEVEL_UPDATE,BP.ACCESS_LEVEL_DELETE,BP.OWNER_,BP.OBJUSAGE_,BP.PRICE,BP.PRICE_CURRENCY,BP.PRICE_LEVEL_,BP.DESCRIPTION,BP.QUANTITY_FROM,BP.QUANTITY_TO,BP.DISCOUNT,BP.DISCOUNT_IS_PERCENTAGE,BP.UOM AS UOM,P.NAME AS PRODUCT_NAME,P.DESCRIPTION AS PRODUCT_DESCRIPTION,P.DISABLED AS PRODUCT_DISABLED,P.OBJECT_ID AS PRODUCT,P.SALES_TAX_TYPE,BP.OBJECT_ID AS BASE_PRICE FROM PUBLIC.OOCKE1_PRODUCTBASEPRICE BP INNER JOIN PUBLIC.OOCKE1_PRODUCT P ON(BP."P$$PARENT"=P.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_TOBJ_PRICELISTENTRY_ (OBJECT_ID,"P$$PARENT",IDX,CREATED_BY,MODIFIED_BY,OWNER,PRICE_LEVEL,OBJUSAGE,DTYPE) AS SELECT BP_.OBJECT_ID,BP."P$$PARENT",BP_.IDX,BP_.CREATED_BY,BP_.MODIFIED_BY,BP_.OWNER,BP_.PRICE_LEVEL,BP_.OBJUSAGE,BP_.DTYPE FROM PUBLIC.OOCKE1_PRODUCTBASEPRICE_ BP_ INNER JOIN PUBLIC.OOCKE1_PRODUCTBASEPRICE BP ON(BP_.OBJECT_ID=BP.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_TOBJ_PROPERTYSETENTRY (OBJECT_ID,"P$$PARENT",CREATED_AT,CREATED_BY_,MODIFIED_AT,MODIFIED_BY_,DTYPE,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_UPDATE,ACCESS_LEVEL_DELETE,OWNER_,PROPERTY_NAME,PROPERTY_DESCRIPTION,PROPERTY_SET_NAME,PROPERTY_SET_DESCRIPTION,STRING_VALUE,INTEGER_VALUE,BOOLEAN_VALUE,URI_VALUE,DECIMAL_VALUE,REFERENCE_VALUE,DATE_VALUE,DATE_TIME_VALUE,PROPERTY) AS SELECT REPLACE(P.OBJECT_ID,'/','*')AS OBJECT_ID,PS."P$$PARENT" AS "P$$PARENT",P.CREATED_AT,P.CREATED_BY_,P.MODIFIED_AT,P.MODIFIED_BY_,REPLACE(REPLACE(P.DTYPE,'org:opencrx:kernel:base:','org:opencrx:kernel:generic:'),'Property','PropertySetEntry')AS DTYPE,P.ACCESS_LEVEL_BROWSE,P.ACCESS_LEVEL_UPDATE,P.ACCESS_LEVEL_DELETE,P.OWNER_,P.NAME AS PROPERTY_NAME,P.DESCRIPTION AS PROPERTY_DESCRIPTION,PS.NAME AS PROPERTY_SET_NAME,PS.DESCRIPTION AS PROPERTY_SET_DESCRIPTION,P.STRING_VALUE,P.INTEGER_VALUE,P.BOOLEAN_VALUE,P.URI_VALUE,P.DECIMAL_VALUE,P.REFERENCE_VALUE,P.DATE_VALUE,P.DATE_TIME_VALUE,P.OBJECT_ID AS PROPERTY FROM PUBLIC.OOCKE1_PROPERTY P INNER JOIN PUBLIC.OOCKE1_PROPERTYSET PS ON(P."P$$PARENT"=PS.OBJECT_ID)UNION ALL SELECT REPLACE(P.OBJECT_ID,'/','*')AS OBJECT_ID,PS."P$$PARENT" AS "P$$PARENT",P.CREATED_AT,P.CREATED_BY_,P.MODIFIED_AT,P.MODIFIED_BY_,REPLACE(REPLACE(P.DTYPE,'org:opencrx:kernel:base:','org:opencrx:kernel:generic:'),'Property','PropertySetEntry')AS DTYPE,P.ACCESS_LEVEL_BROWSE,P.ACCESS_LEVEL_UPDATE,P.ACCESS_LEVEL_DELETE,P.OWNER_,P.NAME AS PROPERTY_NAME,P.DESCRIPTION AS PROPERTY_DESCRIPTION,PS.NAME AS PROPERTY_SET_NAME,PS.DESCRIPTION AS PROPERTY_SET_DESCRIPTION,P.STRING_VALUE,P.INTEGER_VALUE,P.BOOLEAN_VALUE,P.URI_VALUE,P.DECIMAL_VALUE,P.REFERENCE_VALUE,P.DATE_VALUE,P.DATE_TIME_VALUE,P.OBJECT_ID AS PROPERTY FROM PUBLIC.OOCKE1_PROPERTY P INNER JOIN PUBLIC.OOCKE1_PROPERTYSET PS ON(P."P$$PARENT"=PS.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_TOBJ_PROPERTYSETENTRY_ (OBJECT_ID,"P$$PARENT",IDX,CREATED_BY,MODIFIED_BY,OWNER,DTYPE) AS SELECT P_.OBJECT_ID,P."P$$PARENT",P_.IDX,P_.CREATED_BY,P_.MODIFIED_BY,P_.OWNER,P_.DTYPE FROM PUBLIC.OOCKE1_PROPERTY_ P_ INNER JOIN PUBLIC.OOCKE1_PROPERTY P ON P.OBJECT_ID=P_.OBJECT_ID
CREATE VIEW PUBLIC.OOCKE1_TOBJ_SEARCHINDEXENTRY (OBJECT_ID,"P$$PARENT",DTYPE,MODIFIED_AT,MODIFIED_BY_,CREATED_AT,CREATED_BY_,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_UPDATE,ACCESS_LEVEL_DELETE,OWNER_,ACCOUNT_ADDRESS_INDEX,ACCOUNT) AS SELECT REPLACE(ACT.OBJECT_ID,'/','*')AS OBJECT_ID,ACT."P$$PARENT",'org:opencrx:kernel:account1:SearchIndexEntry'AS DTYPE,ACT.MODIFIED_AT,ACT.MODIFIED_BY_,ACT.CREATED_AT,ACT.CREATED_BY_,ACT.ACCESS_LEVEL_BROWSE,ACT.ACCESS_LEVEL_UPDATE,ACT.ACCESS_LEVEL_DELETE,ACT.OWNER_,CASE WHEN ACT.FULL_NAME IS NULL THEN'-'ELSE ACT.FULL_NAME END AS ACCOUNT_ADDRESS_INDEX,ACT.OBJECT_ID AS ACCOUNT FROM PUBLIC.OOCKE1_ACCOUNT ACT UNION ALL SELECT REPLACE(ADR.OBJECT_ID,'/','*')AS OBJECT_ID,ACT."P$$PARENT",'org:opencrx:kernel:account1:SearchIndexEntry'AS DTYPE,ACT.MODIFIED_AT,ACT.MODIFIED_BY_,ACT.CREATED_AT,ACT.CREATED_BY_,ACT.ACCESS_LEVEL_BROWSE,ACT.ACCESS_LEVEL_UPDATE,ACT.ACCESS_LEVEL_DELETE,ACT.OWNER_,CASE WHEN ACT.FULL_NAME IS NULL THEN'-'ELSE ACT.FULL_NAME END||', '||CASE WHEN ADR.EMAIL_ADDRESS IS NULL THEN'-'ELSE ADR.EMAIL_ADDRESS END||', '||CASE WHEN ADR.PHONE_NUMBER_FULL IS NULL THEN'-'ELSE ADR.PHONE_NUMBER_FULL END||', '||CASE WHEN ADR.ROOM_NUMBER IS NULL THEN'-'ELSE ADR.ROOM_NUMBER END||', '||CASE WHEN ADR.POSTAL_STREET_0 IS NULL THEN'-'ELSE ADR.POSTAL_STREET_0 END||', '||CASE WHEN ADR.POSTAL_CODE IS NULL THEN'-'ELSE ADR.POSTAL_CODE END||', '||CASE WHEN ADR.POSTAL_CITY IS NULL THEN'-'ELSE ADR.POSTAL_CITY END AS ACCOUNT_ADDRESS_INDEX,ACT.OBJECT_ID AS ACCOUNT FROM PUBLIC.OOCKE1_ACCOUNT ACT INNER JOIN PUBLIC.OOCKE1_ADDRESS ADR ON(ADR."P$$PARENT"=ACT.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_TOBJ_SEARCHINDEXENTRY_ (OBJECT_ID,"P$$PARENT",IDX,CREATED_BY,MODIFIED_BY,OWNER,DTYPE) AS SELECT A_.OBJECT_ID,A."P$$PARENT",A_.IDX,A_.CREATED_BY,A_.MODIFIED_BY,A_.OWNER,A_.DTYPE FROM PUBLIC.OOCKE1_ACCOUNT_ A_ INNER JOIN PUBLIC.OOCKE1_ACCOUNT A ON A.OBJECT_ID=A_.OBJECT_ID
CREATE VIEW PUBLIC.OOMSE2_TOBJ_USERS (PRINCIPAL_NAME,PASSWD) AS SELECT P.NAME AS PRINCIPAL_NAME,C.PASSWD FROM PUBLIC.OOMSE2_PRINCIPAL P INNER JOIN PUBLIC.OOMSE2_CREDENTIAL C ON(P.CREDENTIAL=C.OBJECT_ID)
CREATE VIEW PUBLIC.OOMSE2_TOBJ_ROLES (PRINCIPAL_NAME,ROLE_NAME) AS SELECT P.NAME AS PRINCIPAL_NAME,R.NAME AS ROLE_NAME FROM PUBLIC.OOMSE2_PRINCIPAL_ PG,PUBLIC.OOMSE2_PRINCIPAL P,PUBLIC.OOMSE2_PRINCIPAL_ PN,PUBLIC.OOMSE2_ROLE R WHERE(P.OBJECT_ID=PN.OBJECT_ID)AND(PN.IS_MEMBER_OF=PG.OBJECT_ID)AND(PG.GRANTED_ROLE=R.OBJECT_ID)AND(P.OBJECT_ID LIKE'principal/%/Root/Default/%')
