CREATE MEMORY TABLE PUBLIC.OOCKE1_WORKLISTSNAPSHOT_(OBJECT_ID VARCHAR(250) NOT NULL,IDX INTEGER NOT NULL,CREATED_BY VARCHAR(256),MODIFIED_BY VARCHAR(256),OWNER VARCHAR(256),DTYPE VARCHAR(256),PRIMARY KEY(OBJECT_ID,IDX))
CREATE MEMORY TABLE PUBLIC.OOCKE1_WORKLIST_(OBJECT_ID VARCHAR(250) NOT NULL,IDX INTEGER NOT NULL,CREATED_BY VARCHAR(256),MODIFIED_BY VARCHAR(256),OWNER VARCHAR(256),DTYPE VARCHAR(256),PRIMARY KEY(OBJECT_ID,IDX))
CREATE VIEW PUBLIC.OOCKE1_JOIN_PRODCLASSHASASSPROD (PRODUCT_CLASSIFICATION,ASSIGNED_PRODUCT) AS SELECT P_.CLASSIFICATION AS PRODUCT_CLASSIFICATION,P_.OBJECT_ID AS ASSIGNED_PRODUCT FROM PUBLIC.OOCKE1_PRODUCT_ P_
CREATE VIEW PUBLIC.OOCKE1_JOIN_SNAPCONTAINSADDITM (ADDED_ITEM,SNAPSHOT) AS SELECT WLI_.OBJECT_ID AS ADDED_ITEM,SNAP.OBJECT_ID AS SNAPSHOT FROM PUBLIC.OOCKE1_WORKLISTITEM_ WLI_ INNER JOIN PUBLIC.OOCKE1_WORKLISTSNAPSHOT SNAP ON WLI_.SNAPSHOT=SNAP.OBJECT_ID WHERE NOT EXISTS(SELECT 0 FROM PUBLIC.OOCKE1_WORKLISTITEM_ WLIP_ WHERE WLIP_.OBJECT_ID=WLI_.OBJECT_ID AND WLIP_.SNAPSHOT=SNAP.PREDECESSOR)
CREATE VIEW PUBLIC.OOCKE1_JOIN_SNAPCONTAINSITM (ITEM,SNAPSHOT) AS SELECT WLI_.OBJECT_ID AS ITEM,WLI_.SNAPSHOT AS SNAPSHOT FROM PUBLIC.OOCKE1_WORKLISTITEM_ WLI_
CREATE VIEW PUBLIC.OOCKE1_JOIN_SNAPCONTAINSREMITM (REMOVED_ITEM,SNAPSHOT) AS SELECT WLI_.OBJECT_ID AS REMOVED_ITEM,SNAP.OBJECT_ID AS SNAPSHOT FROM PUBLIC.OOCKE1_WORKLISTITEM_ WLI_ INNER JOIN PUBLIC.OOCKE1_WORKLISTSNAPSHOT SNAP ON WLI_.SNAPSHOT=SNAP.PREDECESSOR WHERE NOT EXISTS(SELECT 0 FROM PUBLIC.OOCKE1_WORKLISTITEM_ WLIP_ WHERE WLIP_.OBJECT_ID=WLI_.OBJECT_ID AND WLIP_.SNAPSHOT=SNAP.OBJECT_ID)
