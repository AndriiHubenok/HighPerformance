CREATE MEMORY TABLE PUBLIC.OOCKE1_DOCUMENTSCHEMA(OBJECT_ID VARCHAR(250) NOT NULL PRIMARY KEY,ACCESS_LEVEL_BROWSE SMALLINT,ACCESS_LEVEL_DELETE SMALLINT,ACCESS_LEVEL_UPDATE SMALLINT,CREATED_AT TIMESTAMP,CREATED_BY_ INTEGER DEFAULT -1,DESCRIPTION VARCHAR(256),MODIFIED_BY_ INTEGER DEFAULT -1,NAME VARCHAR(256),OWNER_ INTEGER DEFAULT -1,SCHEMA_TEXT CLOB(10000000),SCHEMA_TYPE VARCHAR(256),"P$$PARENT" VARCHAR(256),DTYPE VARCHAR(256),MODIFIED_AT TIMESTAMP)
