CREATE MEMORY TABLE PUBLIC.OOCKE1_DOCUMENTFOLDERSHARE(OBJECT_ID VARCHAR(250) NOT NULL PRIMARY KEY,ACCESS_LEVEL_BROWSE SMALLINT,ACCESS_LEVEL_DELETE SMALLINT,ACCESS_LEVEL_UPDATE SMALLINT,CREATED_AT TIMESTAMP,CREATED_BY_ INTEGER DEFAULT -1,DESCRIPTION VARCHAR(256),"P$$PARENT" VARCHAR(256),IS_ACTIVE BOOLEAN,MODIFIED_BY_ INTEGER DEFAULT -1,NAME VARCHAR(256),OWNER_ INTEGER DEFAULT -1,SHARE_FOR_USER VARCHAR(256),DTYPE VARCHAR(256),MODIFIED_AT TIMESTAMP,SEARCH_DATE_TIME0 TIMESTAMP,SEARCH_DATE_TIME1 TIMESTAMP,SEARCH_DATE_TIME2 TIMESTAMP,SEARCH_DATE_TIME3 TIMESTAMP,SEARCH_DATE_TIME4 TIMESTAMP,SEARCH_DATE_TIME5 TIMESTAMP,SEARCH_DATE_TIME6 TIMESTAMP,SEARCH_DATE_TIME7 TIMESTAMP,SEARCH_DATE_TIME8 TIMESTAMP,SEARCH_DATE_TIME9 TIMESTAMP,SEARCH_NUMBER0 NUMERIC(19,9),SEARCH_NUMBER1 NUMERIC(19,9),SEARCH_NUMBER2 NUMERIC(19,9),SEARCH_NUMBER3 NUMERIC(19,9),SEARCH_NUMBER4 NUMERIC(19,9),SEARCH_NUMBER5 NUMERIC(19,9),SEARCH_NUMBER6 NUMERIC(19,9),SEARCH_NUMBER7 NUMERIC(19,9),SEARCH_NUMBER8 NUMERIC(19,9),SEARCH_NUMBER9 NUMERIC(19,9),SEARCH_STRING0 VARCHAR(256),SEARCH_STRING1 VARCHAR(256),SEARCH_STRING2 VARCHAR(256),SEARCH_STRING3 VARCHAR(256),SEARCH_STRING4 VARCHAR(256),SEARCH_STRING5 VARCHAR(256),SEARCH_STRING6 VARCHAR(256),SEARCH_STRING7 VARCHAR(256),SEARCH_STRING8 VARCHAR(256),SEARCH_STRING9 VARCHAR(256))
CREATE MEMORY TABLE PUBLIC.OOCKE1_DOCUMENTFOLDERSHARE_(OBJECT_ID VARCHAR(250) NOT NULL,IDX INTEGER NOT NULL,CREATED_BY VARCHAR(256),MODIFIED_BY VARCHAR(256),OWNER VARCHAR(256),DTYPE VARCHAR(256),PRIMARY KEY(OBJECT_ID,IDX))
CREATE MEMORY TABLE PUBLIC.OOCKE1_RESOURCERATE(OBJECT_ID VARCHAR(250) NOT NULL PRIMARY KEY,ACCESS_LEVEL_BROWSE SMALLINT,ACCESS_LEVEL_DELETE SMALLINT,ACCESS_LEVEL_UPDATE SMALLINT,CATEGORY_ INTEGER DEFAULT -1,CREATED_AT TIMESTAMP,CREATED_BY_ INTEGER DEFAULT -1,DESCRIPTION VARCHAR(256),DISABLED BOOLEAN,DISABLED_REASON VARCHAR(256),EXTERNAL_LINK_ INTEGER DEFAULT -1,MODIFIED_BY_ INTEGER DEFAULT -1,NAME VARCHAR(256),OWNER_ INTEGER DEFAULT -1,RATE NUMERIC(19,9),RATE_CURRENCY SMALLINT,RATE_TYPE SMALLINT,"P$$PARENT" VARCHAR(256),USER_BOOLEAN0 BOOLEAN,USER_BOOLEAN1 BOOLEAN,USER_BOOLEAN2 BOOLEAN,USER_BOOLEAN3 BOOLEAN,USER_BOOLEAN4_ INTEGER DEFAULT -1,USER_CODE0 SMALLINT,USER_CODE1 SMALLINT,USER_CODE2 SMALLINT,USER_CODE3 SMALLINT,USER_CODE4_ INTEGER DEFAULT -1,USER_DATE0 DATE,USER_DATE1 DATE,USER_DATE2 DATE,USER_DATE3 DATE,USER_DATE4_ INTEGER DEFAULT -1,USER_DATE_TIME0 TIMESTAMP,USER_DATE_TIME1 TIMESTAMP,USER_DATE_TIME2 TIMESTAMP,USER_DATE_TIME3 TIMESTAMP,USER_DATE_TIME4_ INTEGER DEFAULT -1,USER_NUMBER0 NUMERIC(19,9),USER_NUMBER1 NUMERIC(19,9),USER_NUMBER2 NUMERIC(19,9),USER_NUMBER3 NUMERIC(19,9),USER_NUMBER4_ INTEGER DEFAULT -1,USER_STRING0 VARCHAR(256),USER_STRING1 VARCHAR(256),USER_STRING2 VARCHAR(256),USER_STRING3 VARCHAR(256),USER_STRING4_ INTEGER DEFAULT -1,DTYPE VARCHAR(256),MODIFIED_AT TIMESTAMP,SEARCH_DATE_TIME0 TIMESTAMP,SEARCH_DATE_TIME1 TIMESTAMP,SEARCH_DATE_TIME2 TIMESTAMP,SEARCH_DATE_TIME3 TIMESTAMP,SEARCH_DATE_TIME4 TIMESTAMP,SEARCH_DATE_TIME5 TIMESTAMP,SEARCH_DATE_TIME6 TIMESTAMP,SEARCH_DATE_TIME7 TIMESTAMP,SEARCH_DATE_TIME8 TIMESTAMP,SEARCH_DATE_TIME9 TIMESTAMP,SEARCH_NUMBER0 NUMERIC(19,9),SEARCH_NUMBER1 NUMERIC(19,9),SEARCH_NUMBER2 NUMERIC(19,9),SEARCH_NUMBER3 NUMERIC(19,9),SEARCH_NUMBER4 NUMERIC(19,9),SEARCH_NUMBER5 NUMERIC(19,9),SEARCH_NUMBER6 NUMERIC(19,9),SEARCH_NUMBER7 NUMERIC(19,9),SEARCH_NUMBER8 NUMERIC(19,9),SEARCH_NUMBER9 NUMERIC(19,9),SEARCH_STRING0 VARCHAR(256),SEARCH_STRING1 VARCHAR(256),SEARCH_STRING2 VARCHAR(256),SEARCH_STRING3 VARCHAR(256),SEARCH_STRING4 VARCHAR(256),SEARCH_STRING5 VARCHAR(256),SEARCH_STRING6 VARCHAR(256),SEARCH_STRING7 VARCHAR(256),SEARCH_STRING8 VARCHAR(256),SEARCH_STRING9 VARCHAR(256))
CREATE MEMORY TABLE PUBLIC.OOCKE1_RESOURCERATE_(OBJECT_ID VARCHAR(250) NOT NULL,IDX INTEGER NOT NULL,CATEGORY VARCHAR(256),CREATED_BY VARCHAR(256),EXTERNAL_LINK VARCHAR(256),MODIFIED_BY VARCHAR(256),OWNER VARCHAR(256),USER_BOOLEAN4 BOOLEAN,USER_CODE4 SMALLINT,USER_DATE4 DATE,USER_DATE_TIME4 TIMESTAMP,USER_NUMBER4 NUMERIC(19,9),USER_STRING4 VARCHAR(256),DTYPE VARCHAR(256),PRIMARY KEY(OBJECT_ID,IDX))
CREATE VIEW PUBLIC.OOCKE1_TOBJ_ACTIVITYRELSHIP (OBJECT_ID,"P$$PARENT",DTYPE,MODIFIED_AT,CREATED_AT,CREATED_BY_,MODIFIED_BY_,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_UPDATE,ACCESS_LEVEL_DELETE,OWNER_,ACTIVITY_LINK_TYPE,"NAME",DESCRIPTION,BASED_ON,ACTIVITY_FROM,ACTIVITY_TO,DISTANCE) AS SELECT REPLACE(A.OBJECT_ID,'/','*')||'*'||REPLACE(L.OBJECT_ID,'/','*')AS OBJECT_ID,A.OBJECT_ID AS "P$$PARENT",'org:opencrx:kernel:activity1:ActivityRelationship'AS DTYPE,L.MODIFIED_AT,L.CREATED_AT,L.CREATED_BY_,L.MODIFIED_BY_,L.ACCESS_LEVEL_BROWSE,L.ACCESS_LEVEL_UPDATE,L.ACCESS_LEVEL_DELETE,L.OWNER_,100-L.ACTIVITY_LINK_TYPE AS ACTIVITY_LINK_TYPE,L.NAME,L.DESCRIPTION,L.OBJECT_ID AS BASED_ON,L."P$$PARENT" AS ACTIVITY_FROM,L.LINK_TO AS ACTIVITY_TO,-1 AS DISTANCE FROM PUBLIC.OOCKE1_ACTIVITY A,PUBLIC.OOCKE1_ACTIVITYLINK L WHERE L.LINK_TO=A.OBJECT_ID UNION ALL SELECT REPLACE(L.OBJECT_ID,'activityLinkTo/','activityRelationship/')AS OBJECT_ID,A.OBJECT_ID AS "P$$PARENT",'org:opencrx:kernel:activity1:ActivityRelationship'AS DTYPE,L.MODIFIED_AT,L.CREATED_AT,L.CREATED_BY_,L.MODIFIED_BY_,L.ACCESS_LEVEL_BROWSE,L.ACCESS_LEVEL_UPDATE,L.ACCESS_LEVEL_DELETE,L.OWNER_,L.ACTIVITY_LINK_TYPE AS ACTIVITY_LINK_TYPE,L.NAME,L.DESCRIPTION,L.OBJECT_ID AS BASED_ON,A.OBJECT_ID AS ACTIVITY_FROM,L.LINK_TO AS ACTIVITY_TO,1 AS DISTANCE FROM PUBLIC.OOCKE1_ACTIVITY A,PUBLIC.OOCKE1_ACTIVITYLINK L WHERE L."P$$PARENT"=A.OBJECT_ID
CREATE VIEW PUBLIC.OOCKE1_TOBJ_ACTIVITYRELSHIP_ (OBJECT_ID,"P$$PARENT",IDX,CREATED_BY,MODIFIED_BY,OWNER,DTYPE) AS SELECT L_.OBJECT_ID,L."P$$PARENT",L_.IDX,L_.CREATED_BY,L_.MODIFIED_BY,L_.OWNER,L_.DTYPE FROM PUBLIC.OOCKE1_ACTIVITYLINK_ L_ INNER JOIN PUBLIC.OOCKE1_ACTIVITYLINK L ON L.OBJECT_ID=L_.OBJECT_ID
CREATE VIEW PUBLIC.OOCKE1_TOBJ_WORKRECORD (OBJECT_ID,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_DELETE,ACCESS_LEVEL_UPDATE,"P$$PARENT",BILLABLE_AMOUNT,BILLING_CURRENCY,CREATED_AT,CREATED_BY_,DEPOT_SELECTOR,DESCRIPTION,ENDED_AT,IS_BILLABLE,MODIFIED_BY_,"NAME",OWNER_,RATE,STARTED_AT,WORK_CB,MODIFIED_AT,DTYPE,IS_REIMBURSABLE,PAYMENT_TYPE,QUANTITY,QUANTITY_UOM,RECORD_TYPE,CATEGORY_,DISABLED,DISABLED_REASON,EXTERNAL_LINK_,USER_BOOLEAN0,USER_BOOLEAN1,USER_BOOLEAN2,USER_BOOLEAN3,USER_BOOLEAN4_,USER_CODE0,USER_CODE1,USER_CODE2,USER_CODE3,USER_CODE4_,USER_DATE0,USER_DATE1,USER_DATE2,USER_DATE3,USER_DATE4_,USER_DATE_TIME0,USER_DATE_TIME1,USER_DATE_TIME2,USER_DATE_TIME3,USER_DATE_TIME4_,USER_NUMBER0,USER_NUMBER1,USER_NUMBER2,USER_NUMBER3,USER_NUMBER4_,USER_STRING0,USER_STRING1,USER_STRING2,USER_STRING3,USER_STRING4_,CONFIG_TYPE,CURRENT_CONFIG,PRODUCT,PRODUCT_SERIAL_NUMBER_,SEARCH_DATE_TIME0,SEARCH_DATE_TIME1,SEARCH_DATE_TIME2,SEARCH_DATE_TIME3,SEARCH_DATE_TIME4,SEARCH_DATE_TIME5,SEARCH_DATE_TIME6,SEARCH_DATE_TIME7,SEARCH_DATE_TIME8,SEARCH_DATE_TIME9,SEARCH_NUMBER0,SEARCH_NUMBER1,SEARCH_NUMBER2,SEARCH_NUMBER3,SEARCH_NUMBER4,SEARCH_NUMBER5,SEARCH_NUMBER6,SEARCH_NUMBER7,SEARCH_NUMBER8,SEARCH_NUMBER9,SEARCH_STRING0,SEARCH_STRING1,SEARCH_STRING2,SEARCH_STRING3,SEARCH_STRING4,SEARCH_STRING5,SEARCH_STRING6,SEARCH_STRING7,SEARCH_STRING8,SEARCH_STRING9,ACTIVITY,RESRC) AS SELECT W.OBJECT_ID,W.ACCESS_LEVEL_BROWSE,W.ACCESS_LEVEL_DELETE,W.ACCESS_LEVEL_UPDATE,W."P$$PARENT",W.BILLABLE_AMOUNT,W.BILLING_CURRENCY,W.CREATED_AT,W.CREATED_BY_,W.DEPOT_SELECTOR,W.DESCRIPTION,W.ENDED_AT,W.IS_BILLABLE,W.MODIFIED_BY_,W."NAME",W.OWNER_,W.RATE,W.STARTED_AT,W.WORK_CB,W.MODIFIED_AT,W.DTYPE,W.IS_REIMBURSABLE,W.PAYMENT_TYPE,W.QUANTITY,W.QUANTITY_UOM,W.RECORD_TYPE,W.CATEGORY_,W.DISABLED,W.DISABLED_REASON,W.EXTERNAL_LINK_,W.USER_BOOLEAN0,W.USER_BOOLEAN1,W.USER_BOOLEAN2,W.USER_BOOLEAN3,W.USER_BOOLEAN4_,W.USER_CODE0,W.USER_CODE1,W.USER_CODE2,W.USER_CODE3,W.USER_CODE4_,W.USER_DATE0,W.USER_DATE1,W.USER_DATE2,W.USER_DATE3,W.USER_DATE4_,W.USER_DATE_TIME0,W.USER_DATE_TIME1,W.USER_DATE_TIME2,W.USER_DATE_TIME3,W.USER_DATE_TIME4_,W.USER_NUMBER0,W.USER_NUMBER1,W.USER_NUMBER2,W.USER_NUMBER3,W.USER_NUMBER4_,W.USER_STRING0,W.USER_STRING1,W.USER_STRING2,W.USER_STRING3,W.USER_STRING4_,W.CONFIG_TYPE,W.CURRENT_CONFIG,W.PRODUCT,W.PRODUCT_SERIAL_NUMBER_,W.SEARCH_DATE_TIME0,W.SEARCH_DATE_TIME1,W.SEARCH_DATE_TIME2,W.SEARCH_DATE_TIME3,W.SEARCH_DATE_TIME4,W.SEARCH_DATE_TIME5,W.SEARCH_DATE_TIME6,W.SEARCH_DATE_TIME7,W.SEARCH_DATE_TIME8,W.SEARCH_DATE_TIME9,W.SEARCH_NUMBER0,W.SEARCH_NUMBER1,W.SEARCH_NUMBER2,W.SEARCH_NUMBER3,W.SEARCH_NUMBER4,W.SEARCH_NUMBER5,W.SEARCH_NUMBER6,W.SEARCH_NUMBER7,W.SEARCH_NUMBER8,W.SEARCH_NUMBER9,W.SEARCH_STRING0,W.SEARCH_STRING1,W.SEARCH_STRING2,W.SEARCH_STRING3,W.SEARCH_STRING4,W.SEARCH_STRING5,W.SEARCH_STRING6,W.SEARCH_STRING7,W.SEARCH_STRING8,W.SEARCH_STRING9,(SELECT "P$$PARENT" FROM PUBLIC.OOCKE1_RESOURCEASSIGNMENT RA WHERE W."P$$PARENT"=RA.OBJECT_ID)AS ACTIVITY,(SELECT RESRC FROM PUBLIC.OOCKE1_RESOURCEASSIGNMENT RA WHERE W."P$$PARENT"=RA.OBJECT_ID)AS RESRC FROM PUBLIC.OOCKE1_WORKRECORD W
CREATE MEMORY TABLE PUBLIC.OOCKE1_WFPROCESSINSTANCEPARAM(OBJECT_ID VARCHAR(250) NOT NULL PRIMARY KEY,ACCESS_LEVEL_BROWSE SMALLINT,ACCESS_LEVEL_DELETE SMALLINT,ACCESS_LEVEL_UPDATE SMALLINT,CREATED_AT TIMESTAMP,CREATED_BY_ INTEGER DEFAULT -1,MODIFIED_BY_ INTEGER DEFAULT -1,NAME VARCHAR(256),OWNER_ INTEGER DEFAULT -1,"P$$PARENT" VARCHAR(256),DTYPE VARCHAR(256),MODIFIED_AT TIMESTAMP,INTEGER_VALUE INTEGER,DATE_TIME_VALUE TIMESTAMP,STRING_VALUE VARCHAR(256),DATE_VALUE DATE,BOOLEAN_VALUE BOOLEAN,DECIMAL_VALUE NUMERIC(19,9),REFERENCE_VALUE VARCHAR(256),URI_VALUE VARCHAR(256))
CREATE MEMORY TABLE PUBLIC.OOCKE1_WFPROCESSINSTANCEPARAM_(OBJECT_ID VARCHAR(250) NOT NULL,IDX INTEGER NOT NULL,CREATED_BY VARCHAR(256),MODIFIED_BY VARCHAR(256),OWNER VARCHAR(256),DTYPE VARCHAR(256),PRIMARY KEY(OBJECT_ID,IDX))
CREATE VIEW PUBLIC.OOCKE1_JOIN_BOCONTAINSCB (BOOKING_ORIGIN,COMPOUND_BOOKING) AS SELECT CB.ORIGIN AS BOOKING_ORIGIN,CB.OBJECT_ID AS COMPOUND_BOOKING FROM PUBLIC.OOCKE1_COMPOUNDBOOKING CB
CREATE VIEW PUBLIC.OOCKE1_TOBJ_AGGRDEPOTREPITEM (OBJECT_ID,"P$$PARENT",DTYPE,MODIFIED_AT,CREATED_AT,CREATED_BY_,MODIFIED_BY_,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_UPDATE,ACCESS_LEVEL_DELETE,OWNER_,BOOKING_PERIOD,BOOKING_PERIOD_NAME,POSITION_NAME,SUM_BALANCE,SUM_BALANCE_BOP,SUM_BALANCE_CREDIT,SUM_BALANCE_CREDIT_BOP,SUM_BALANCE_DEBIT,SUM_BALANCE_DEBIT_BOP,SUM_BALANCE_SIMPLE,SUM_BALANCE_SIMPLE_BOP) AS SELECT REPLACE(DG0.OBJECT_ID,'/','*')||'*'||REPLACE(BOOKING_PERIOD,'/','*')||'*'||REPLACE(DRI.POSITION_NAME,'/','*')AS OBJECT_ID,DG0.OBJECT_ID AS "P$$PARENT",'org:opencrx:kernel:depot1:AggregatedDepotReportItem'AS DTYPE,(SELECT PERIOD_STARTS_AT FROM PUBLIC.OOCKE1_BOOKINGPERIOD BP WHERE BP.OBJECT_ID=DR.BOOKING_PERIOD)AS MODIFIED_AT,(SELECT PERIOD_STARTS_AT FROM PUBLIC.OOCKE1_BOOKINGPERIOD BP WHERE BP.OBJECT_ID=DR.BOOKING_PERIOD)AS CREATED_AT,DG0.CREATED_BY_ AS CREATED_BY_,DG0.MODIFIED_BY_ AS MODIFIED_BY_,DG0.ACCESS_LEVEL_BROWSE AS ACCESS_LEVEL_BROWSE,DG0.ACCESS_LEVEL_UPDATE AS ACCESS_LEVEL_UPDATE,DG0.ACCESS_LEVEL_DELETE AS ACCESS_LEVEL_DELETE,DG0.OWNER_,DR.BOOKING_PERIOD AS BOOKING_PERIOD,(SELECT NAME FROM PUBLIC.OOCKE1_BOOKINGPERIOD BP WHERE BP.OBJECT_ID=DR.BOOKING_PERIOD)AS BOOKING_PERIOD_NAME,DRI.POSITION_NAME AS POSITION_NAME,SUM(DRI.BALANCE)AS SUM_BALANCE,SUM(DRI.BALANCE_BOP)AS SUM_BALANCE_BOP,SUM(DRI.BALANCE_CREDIT)AS SUM_BALANCE_CREDIT,SUM(DRI.BALANCE_CREDIT_BOP)AS SUM_BALANCE_CREDIT_BOP,SUM(DRI.BALANCE_DEBIT)AS SUM_BALANCE_DEBIT,SUM(DRI.BALANCE_DEBIT_BOP)AS SUM_BALANCE_DEBIT_BOP,SUM(DRI.BALANCE_SIMPLE)AS SUM_BALANCE_SIMPLE,SUM(DRI.BALANCE_SIMPLE_BOP)AS SUM_BALANCE_SIMPLE_BOP FROM PUBLIC.OOCKE1_DEPOTREPORTITEM DRI INNER JOIN PUBLIC.OOCKE1_DEPOTREPORT DR ON DRI."P$$PARENT"=DR.OBJECT_ID INNER JOIN PUBLIC.OOCKE1_DEPOT D ON DR."P$$PARENT"=D.OBJECT_ID INNER JOIN PUBLIC.OOCKE1_DEPOTGROUP DG0 ON D.DEPOT_GROUP=DG0.OBJECT_ID GROUP BY DG0.OBJECT_ID,DR.BOOKING_PERIOD,DRI.POSITION_NAME,DG0.CREATED_BY_,DG0.MODIFIED_BY_,DG0.ACCESS_LEVEL_BROWSE,DG0.ACCESS_LEVEL_DELETE,DG0.ACCESS_LEVEL_UPDATE,DG0.OWNER_ UNION ALL SELECT REPLACE(DG0.OBJECT_ID,'/','*')||'*'||REPLACE(BOOKING_PERIOD,'/','*')||'*'||REPLACE(DRI.POSITION_NAME,'/','*')AS OBJECT_ID,DG0.OBJECT_ID AS "P$$PARENT",'org:opencrx:kernel:depot1:AggregatedDepotReportItem'AS DTYPE,(SELECT PERIOD_STARTS_AT FROM PUBLIC.OOCKE1_BOOKINGPERIOD BP WHERE BP.OBJECT_ID=DR.BOOKING_PERIOD)AS MODIFIED_AT,(SELECT PERIOD_STARTS_AT FROM PUBLIC.OOCKE1_BOOKINGPERIOD BP WHERE BP.OBJECT_ID=DR.BOOKING_PERIOD)AS CREATED_AT,DG0.CREATED_BY_ AS CREATED_BY_,DG0.MODIFIED_BY_ AS MODIFIED_BY_,DG0.ACCESS_LEVEL_BROWSE AS ACCESS_LEVEL_BROWSE,DG0.ACCESS_LEVEL_UPDATE AS ACCESS_LEVEL_UPDATE,DG0.ACCESS_LEVEL_DELETE AS ACCESS_LEVEL_DELETE,DG0.OWNER_,DR.BOOKING_PERIOD AS BOOKING_PERIOD,(SELECT NAME FROM PUBLIC.OOCKE1_BOOKINGPERIOD BP WHERE BP.OBJECT_ID=DR.BOOKING_PERIOD)AS BOOKING_PERIOD_NAME,DRI.POSITION_NAME AS POSITION_NAME,SUM(DRI.BALANCE)AS SUM_BALANCE,SUM(DRI.BALANCE_BOP)AS SUM_BALANCE_BOP,SUM(DRI.BALANCE_CREDIT)AS SUM_BALANCE_CREDIT,SUM(DRI.BALANCE_CREDIT_BOP)AS SUM_BALANCE_CREDIT_BOP,SUM(DRI.BALANCE_DEBIT)AS SUM_BALANCE_DEBIT,SUM(DRI.BALANCE_DEBIT_BOP)AS SUM_BALANCE_DEBIT_BOP,SUM(DRI.BALANCE_SIMPLE)AS SUM_BALANCE_SIMPLE,SUM(DRI.BALANCE_SIMPLE_BOP)AS SUM_BALANCE_SIMPLE_BOP FROM PUBLIC.OOCKE1_DEPOTREPORTITEM DRI INNER JOIN PUBLIC.OOCKE1_DEPOTREPORT DR ON DRI."P$$PARENT"=DR.OBJECT_ID INNER JOIN PUBLIC.OOCKE1_DEPOT D ON DR."P$$PARENT"=D.OBJECT_ID INNER JOIN PUBLIC.OOCKE1_DEPOTGROUP DG1 ON D.DEPOT_GROUP=DG1.OBJECT_ID INNER JOIN PUBLIC.OOCKE1_DEPOTGROUP DG0 ON DG1.PARENT=DG0.OBJECT_ID GROUP BY DG0.OBJECT_ID,DR.BOOKING_PERIOD,DRI.POSITION_NAME,DG0.CREATED_BY_,DG0.MODIFIED_BY_,DG0.ACCESS_LEVEL_BROWSE,DG0.ACCESS_LEVEL_DELETE,DG0.ACCESS_LEVEL_UPDATE,DG0.OWNER_ UNION ALL SELECT REPLACE(DG0.OBJECT_ID,'/','*')||'*'||REPLACE(BOOKING_PERIOD,'/','*')||'*'||REPLACE(DRI.POSITION_NAME,'/','*')AS OBJECT_ID,DG0.OBJECT_ID AS "P$$PARENT",'org:opencrx:kernel:depot1:AggregatedDepotReportItem'AS DTYPE,(SELECT PERIOD_STARTS_AT FROM PUBLIC.OOCKE1_BOOKINGPERIOD BP WHERE BP.OBJECT_ID=DR.BOOKING_PERIOD)AS MODIFIED_AT,(SELECT PERIOD_STARTS_AT FROM PUBLIC.OOCKE1_BOOKINGPERIOD BP WHERE BP.OBJECT_ID=DR.BOOKING_PERIOD)AS CREATED_AT,DG0.CREATED_BY_ AS CREATED_BY_,DG0.MODIFIED_BY_ AS MODIFIED_BY_,DG0.ACCESS_LEVEL_BROWSE AS ACCESS_LEVEL_BROWSE,DG0.ACCESS_LEVEL_UPDATE AS ACCESS_LEVEL_UPDATE,DG0.ACCESS_LEVEL_DELETE AS ACCESS_LEVEL_DELETE,DG0.OWNER_,DR.BOOKING_PERIOD AS BOOKING_PERIOD,(SELECT NAME FROM PUBLIC.OOCKE1_BOOKINGPERIOD BP WHERE BP.OBJECT_ID=DR.BOOKING_PERIOD)AS BOOKING_PERIOD_NAME,DRI.POSITION_NAME AS POSITION_NAME,SUM(DRI.BALANCE)AS SUM_BALANCE,SUM(DRI.BALANCE_BOP)AS SUM_BALANCE_BOP,SUM(DRI.BALANCE_CREDIT)AS SUM_BALANCE_CREDIT,SUM(DRI.BALANCE_CREDIT_BOP)AS SUM_BALANCE_CREDIT_BOP,SUM(DRI.BALANCE_DEBIT)AS SUM_BALANCE_DEBIT,SUM(DRI.BALANCE_DEBIT_BOP)AS SUM_BALANCE_DEBIT_BOP,SUM(DRI.BALANCE_SIMPLE)AS SUM_BALANCE_SIMPLE,SUM(DRI.BALANCE_SIMPLE_BOP)AS SUM_BALANCE_SIMPLE_BOP FROM PUBLIC.OOCKE1_DEPOTREPORTITEM DRI INNER JOIN PUBLIC.OOCKE1_DEPOTREPORT DR ON DRI."P$$PARENT"=DR.OBJECT_ID INNER JOIN PUBLIC.OOCKE1_DEPOT D ON DR."P$$PARENT"=D.OBJECT_ID INNER JOIN PUBLIC.OOCKE1_DEPOTGROUP DG2 ON D.DEPOT_GROUP=DG2.OBJECT_ID INNER JOIN PUBLIC.OOCKE1_DEPOTGROUP DG1 ON DG2.PARENT=DG1.OBJECT_ID INNER JOIN PUBLIC.OOCKE1_DEPOTGROUP DG0 ON DG1.PARENT=DG0.OBJECT_ID GROUP BY DG0.OBJECT_ID,DR.BOOKING_PERIOD,DRI.POSITION_NAME,DG0.CREATED_BY_,DG0.MODIFIED_BY_,DG0.ACCESS_LEVEL_BROWSE,DG0.ACCESS_LEVEL_DELETE,DG0.ACCESS_LEVEL_UPDATE,DG0.OWNER_
CREATE VIEW PUBLIC.OOCKE1_TOBJ_AGGRDEPOTREPITEM_ (OBJECT_ID,"P$$PARENT",IDX,CREATED_BY,MODIFIED_BY,OWNER,DTYPE) AS SELECT DG_.OBJECT_ID,DG_.OBJECT_ID AS "P$$PARENT",DG_.IDX,DG_.CREATED_BY,DG_.MODIFIED_BY,DG_.OWNER,DG_.DTYPE FROM PUBLIC.OOCKE1_DEPOTGROUP_ DG_
CREATE VIEW PUBLIC.OOCKE1_TOBJ_ASSACCTASS (OBJECT_ID,"P$$PARENT",DTYPE,MODIFIED_AT,CREATED_AT,CREATED_BY_,MODIFIED_BY_,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_UPDATE,ACCESS_LEVEL_DELETE,OWNER_,DISABLED,DISABLED_REASON,NAME,DESCRIPTION,ACCOUNT_ASSIGNMENT_HOLDER,ACCOUNT_ASSIGNMENT,VALID_FROM,VALID_TO,ACCOUNT_ROLE) AS SELECT REPLACE(ASS.ACCOUNT,'/','*')||'*'||REPLACE(ASS.OBJECT_ID,'/','*')AS OBJECT_ID,ASS.ACCOUNT AS "P$$PARENT",CASE WHEN ASS.DTYPE='org:opencrx:kernel:product1:AccountAssignmentProduct'THEN'org:opencrx:kernel:account1:AssignedAccountAssignmentProduct'WHEN ASS.DTYPE='org:opencrx:kernel:building1:AccountAssignmentInventoryItem'THEN'org:opencrx:kernel:account1:AssignedAccountAssignmentInventoryItem'WHEN ASS.DTYPE='org:opencrx:kernel:contract1:AccountAssignmentContract'THEN'org:opencrx:kernel:account1:AssignedAccountAssignmentContract'WHEN ASS.DTYPE='org:opencrx:kernel:activity1:AccountAssignmentActivityGroup'THEN'org:opencrx:kernel:account1:AssignedAccountAssignmentActivityGroup'END AS DTYPE,ASS.MODIFIED_AT AS MODIFIED_AT,ASS.CREATED_AT AS CREATED_AT,ASS.CREATED_BY_ AS CREATED_BY_,ASS.MODIFIED_BY_ AS MODIFIED_BY_,ASS.ACCESS_LEVEL_BROWSE AS ACCESS_LEVEL_BROWSE,ASS.ACCESS_LEVEL_UPDATE AS ACCESS_LEVEL_UPDATE,ASS.ACCESS_LEVEL_DELETE AS ACCESS_LEVEL_DELETE,ASS.OWNER_,ASS.DISABLED,ASS.DISABLED_REASON,ASS.NAME AS NAME,ASS.DESCRIPTION AS DESCRIPTION,ASS."P$$PARENT" AS ACCOUNT_ASSIGNMENT_HOLDER,ASS.OBJECT_ID AS ACCOUNT_ASSIGNMENT,ASS.VALID_FROM AS VALID_FROM,ASS.VALID_TO AS VALID_TO,ASS.ACCOUNT_ROLE AS ACCOUNT_ROLE FROM PUBLIC.OOCKE1_ACCOUNTASSIGNMENT ASS WHERE ASS.DTYPE IN('org:opencrx:kernel:product1:AccountAssignmentProduct','org:opencrx:kernel:building1:AccountAssignmentInventoryItem','org:opencrx:kernel:contract1:AccountAssignmentContract','org:opencrx:kernel:activity1:AccountAssignmentActivityGroup')
CREATE VIEW PUBLIC.OOCKE1_TOBJ_ASSACCTASS_ (OBJECT_ID,"P$$PARENT",IDX,CREATED_BY,MODIFIED_BY,OWNER,DTYPE) AS SELECT AA_.OBJECT_ID,AA."P$$PARENT",AA_.IDX,AA_.CREATED_BY,AA_.MODIFIED_BY,AA_.OWNER,AA_.DTYPE FROM PUBLIC.OOCKE1_ACCOUNTASSIGNMENT_ AA_ INNER JOIN PUBLIC.OOCKE1_ACCOUNTASSIGNMENT AA ON AA_.OBJECT_ID=AA.OBJECT_ID
CREATE VIEW PUBLIC.OOCKE1_TOBJ_SINGLEBOOKINGENTRY (OBJECT_ID,"P$$PARENT",DTYPE,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_DELETE,ACCESS_LEVEL_UPDATE,BOOKING_DATE,ORIGIN,BOOKING_STATUS,BOOKING_TYPE,CB,CREATED_AT,CREATED_BY_,DEPOT,DEPOT_ENTITY,DEPOT_HOLDER,DESCRIPTION,MODIFIED_BY_,NAME,ORIGIN_CONTEXT_PARAMS_,ORIGIN_CONTEXT_,OWNER_,POSITION,SINGLE_BOOKING,VALUE_DATE,MODIFIED_AT,QUANTITY_DEBIT,QUANTITY_CREDIT) AS SELECT REPLACE(B.OBJECT_ID,'booking/','bookingEntry/')AS OBJECT_ID,B."P$$PARENT" AS "P$$PARENT",'org:opencrx:kernel:depot1:SingleBookingEntry'AS DTYPE,B.ACCESS_LEVEL_BROWSE AS ACCESS_LEVEL_BROWSE,B.ACCESS_LEVEL_DELETE AS ACCESS_LEVEL_DELETE,B.ACCESS_LEVEL_UPDATE AS ACCESS_LEVEL_UPDATE,B.BOOKING_DATE AS BOOKING_DATE,B.ORIGIN AS ORIGIN,B.BOOKING_STATUS AS BOOKING_STATUS,B.BOOKING_TYPE AS BOOKING_TYPE,B.CB AS CB,B.CREATED_AT AS CREATED_AT,B.CREATED_BY_ AS CREATED_BY_,D.OBJECT_ID AS DEPOT,DE.OBJECT_ID AS DEPOT_ENTITY,DH.OBJECT_ID AS DEPOT_HOLDER,B.DESCRIPTION AS DESCRIPTION,B.MODIFIED_BY_ AS MODIFIED_BY_,B.NAME AS NAME,B.ORIGIN_CONTEXT_PARAMS_ AS ORIGIN_CONTEXT_PARAMS_,B.ORIGIN_CONTEXT_ AS ORIGIN_CONTEXT_,B.OWNER_ AS OWNER_,B.POSITION AS POSITION,B.OBJECT_ID AS SINGLE_BOOKING,B.VALUE_DATE AS VALUE_DATE,B.MODIFIED_AT AS MODIFIED_AT,B.QUANTITY_DEBIT AS QUANTITY_DEBIT,B.QUANTITY_CREDIT AS QUANTITY_CREDIT FROM PUBLIC.OOCKE1_BOOKING B INNER JOIN PUBLIC.OOCKE1_DEPOTPOSITION DP ON B.POSITION=DP.OBJECT_ID INNER JOIN PUBLIC.OOCKE1_DEPOT D ON DP."P$$PARENT"=D.OBJECT_ID INNER JOIN PUBLIC.OOCKE1_DEPOTHOLDER DH ON D."P$$PARENT"=DH.OBJECT_ID INNER JOIN PUBLIC.OOCKE1_DEPOTENTITY DE ON DH."P$$PARENT"=DE.OBJECT_ID
CREATE VIEW PUBLIC.OOCKE1_TOBJ_SINGLEBOOKINGENTRY_ (OBJECT_ID,IDX,DTYPE,CREATED_BY,MODIFIED_BY,ORIGIN_CONTEXT,ORIGIN_CONTEXT_PARAMS,OWNER) AS SELECT REPLACE(B_.OBJECT_ID,'booking/','bookingEntry/')AS OBJECT_ID,B_.IDX AS IDX,'org:opencrx:kernel:depot1:SingleBookingEntry'AS DTYPE,B_.CREATED_BY AS CREATED_BY,B_.MODIFIED_BY AS MODIFIED_BY,B_.ORIGIN_CONTEXT AS ORIGIN_CONTEXT,B_.ORIGIN_CONTEXT_PARAMS AS ORIGIN_CONTEXT_PARAMS,B_.OWNER AS OWNER FROM PUBLIC.OOCKE1_BOOKING_ B_
