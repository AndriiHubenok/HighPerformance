INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',0,'admin-Root','admin-Root','Root:admin-Root.User','org:opencrx:kernel:code1:CodeValueEntry','Media access failure. Possible reasons are: field value too long, database table corrupt or invalid, database not available. See log for details: ${0}','10001')
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',1,NULL,NULL,'Root:admin-Root.User','org:opencrx:kernel:code1:CodeValueEntry','Media access failure. M\u00f6gliche Ursachen sind: Eingabewert(e) zu lang/gross, Datenbanktabelle korrupt oder ung\u00fcltig, Datenbank nicht verf\u00fcgbar. Das Log-File enth\u00e4lt weitere Details: ${0}',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',2,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Falla de Acceso. Las causas pueden ser: valor del campo demasiado largo, tabla de la base de datos corrupta o invalida, base de datos no disponible. Ver el log para mayor detalle: ${0}',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',3,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','\u5a92\u4f53\u8bbf\u95ee\u5931\u8d25\u3002\u53ef\u80fd\u662f\u56e0\u4e3a: \u5b57\u6bb5\u503c\u8fc7\u957f\uff0c\u6570\u636e\u5e93\u8868\u635f\u574f\u6216\u65e0\u6548\uff0c\u6570\u636e\u5e93\u65e0\u6548\u3002 \u8be6\u7ec6\u4fe1\u606f\u8bf7\u67e5\u770b\u65e5\u5fd7: {0}',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',4,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','\u00c5tkomst till media nekad. M\u00f6jliga anledningar \u00e4r: f\u00f6r l\u00e5ngt f\u00e4ltv\u00e4rde, korrupt databastabell, databas ej tillg\u00e4nglig. See logg f\u00f6r ytterligare detaljer: ${0}',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',5,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Ortam eri\u015fim hatas\u0131. Olas\u0131 nedenler : alan de\u011feri \u00e7ok uzun, veritaban\u0131 tablosu bozuk yada ge\u00e7ersiz, veritaban\u0131 eri\u015filemez durumda. Ayr\u0131nt\u0131lar i\u00e7in log dosyas\u0131na bak\u0131n\u0131z: ${0}',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',6,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Media access failure. Possible reasons are: field value too long, database table corrupt or invalid, database not available. See log for details: ${0}',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',7,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Erreur d''acc\u00e8s bas niveau. Les raisons possibles sont : valeur du champ trop longue, base de donn\u00e9e corrompue, base de donn\u00e9e indisponible. Consulter le fichier de log pour plus de d\u00e9tails: ${0}',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',8,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Accesso fallito. Possibili cause: valore troppo lungo, tabella del db corrotta o non valida, database non valido. Vedi il log per i dettagli: ${0}',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',9,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',10,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',11,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','\u041e\u0442\u043a\u0430\u0437 \u0432 \u0434\u043e\u0441\u0442\u0443\u043f\u0435 \u043a \u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044e. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435 \u043f\u0440\u0438\u0447\u0438\u043d\u044b: \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u044f \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0431\u043e\u043b\u044c\u0448\u043e\u0435, \u0442\u0430\u0431\u043b\u0438\u0446\u0430 \u0431\u0430\u0437 \u0434\u0430\u043d\u043d\u044b\u0445 \u0438\u0441\u043f\u043e\u0440\u0447\u0435\u043d\u0430 \u0438\u043b\u0438 \u043d\u0435\u0432\u0435\u0440\u043d\u0430, \u0431\u0430\u0437\u0430 \u0434\u0430\u043d\u043d\u044b\u0445 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430. \u0414\u043b\u044f \u0434\u0435\u0442\u0430\u043b\u0435\u0439 \u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u0436\u0443\u0440\u043d\u0430\u043b: ${0}',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',12,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Awaria wykazaniia media. Pow\u00f3dd mo\u017ce by\u0107: warto\u0107\u0107 pola za d\u0142uga, tabela bazy danych jest skorumpowana lub niewa\u017cna, baza danych jest nie dost\u0119pna.Prosz\u0119 zobaczy\u0107 plik ''log'': ${0}',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',13,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','\u30a2\u30af\u30bb\u30b9\u304c\u5931\u6557\u3057\u307e\u3057\u305f\u3002\u8003\u3048\u3089\u308c\u308b\u7406\u7531: \u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u5024\u304c\u9577\u3059\u304e\u308b\u304b\u3001\u30c7\u30fc\u30bf\u30d9\u30fc\u30b9\u306e\u30c6\u30fc\u30d6\u30eb\u304c\u58ca\u308c\u3066\u3044\u308b\u304b\u3001\u30c7\u30fc\u30bf\u30d9\u30fc\u30b9\u304c\u5229\u7528\u3067\u304d\u307e\u305b\u3093\u3002 \u8a73\u7d30\u306f\u30ed\u30b0 ${0} \u3092\u898b\u3066\u4e0b\u3055\u3044\u3002 ',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',14,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Falha ao acessar m\u00eddia. As raz\u00f5es poss\u00edveis s\u00e3o: valor do campo muito longo, tabelas do banco est\u00e3o inv\u00e1lidas, banco de dados n\u00e3o dispon\u00edvel. Veja o log para detalhes: ${0}',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/2',15,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Selh\u00e1n\u00ed p\u00f8\u00edstupu k m\u00e9diu. Mo\u017en\u00e9 p\u00f8\u00ed\u00e8iny jsou: hodnota pole p\u00f8\u00edli\u0161 dlouh\u00e1, po\u0161kozen\u00e1 tabulka datab\u00e1ze, nedostupn\u00e1 datab\u00e1ze. Prohl\u00e9dn\u00ecte log pro detaily: ${0}',NULL)
