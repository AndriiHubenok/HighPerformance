INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/116',3,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','\u5c5e\u6027''{0}''\u7684\u503c''{1}''\u5f15\u7528\u7684\u5bf9\u8c61\u65e0\u6548\u3002\u4f60\u53ef\u4ee5\u901a\u8fc7\u5bf9\u8c61\u67e5\u770b\u5668\u6216\u590d\u5236\u4e00\u4e2a\u6709\u6548\u7684\u5f15\u7528\u6765\u8bbe\u7f6e\u3002',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/116',4,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','V\u00e4rdet ''${1}'' i f\u00e4ltet ''${0}'' refererar inte till ett giltigt objekt. Du kan ange en giltig referens med hj\u00e4lp av objekts\u00f6kfunktionen eller genom att kopiera en befintlig referens',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/116',5,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','''${0}'' alan\u0131n\u0131n ''${1}'' de\u011feri ge\u00e7erli bir nesneye referans vermiyor. Ge\u00e7erli bir referans\u0131 \u00fcstbakis (lookup) ile alabilir ya da ge\u00e7erli bir nesne referans\u0131n\u0131 kopyalayabilirsiniz.',NULL)
