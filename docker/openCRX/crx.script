EARCH_STRING0 VARCHAR(256),SEARCH_STRING1 VARCHAR(256),SEARCH_STRING2 VARCHAR(256),SEARCH_STRING3 VARCHAR(256),SEARCH_STRING4 VARCHAR(256),SEARCH_STRING5 VARCHAR(256),SEARCH_STRING6 VARCHAR(256),SEARCH_STRING7 VARCHAR(256),SEARCH_STRING8 VARCHAR(256),SEARCH_STRING9 VARCHAR(256))
