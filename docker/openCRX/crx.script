CREATE VIEW PUBLIC.OOCKE1_JOIN_CONTGCONTAINSCONTR (CONTRACT_GROUP,FILTERED_CONTRACT) AS SELECT GA.CONTRACT_GROUP AS CONTRACT_GROUP,(GA."P$$PARENT")AS FILTERED_CONTRACT FROM PUBLIC.OOCKE1_CONTRACTGROUP G INNER JOIN PUBLIC.OOCKE1_CONTRACTGROUPASS GA ON(GA.CONTRACT_GROUP=G.OBJECT_ID)
CREATE VIEW PUBLIC.OOCKE1_JOIN_ACCTHASASSADDRESS (ASSIGNED_ADDRESS,ACCOUNT) AS SELECT ADDR.OBJECT_ID AS ASSIGNED_ADDRESS,ADDR.AUTHORITY AS ACCOUNT FROM PUBLIC.OOCKE1_ADDRESS ADDR
CREATE MEMORY TABLE PUBLIC.OOCKE1_REMINDER(OBJECT_ID VARCHAR(256) NOT NULL PRIMARY KEY,ACCESS_LEVEL_BROWSE SMALLINT,ACCESS_LEVEL_DELETE SMALLINT,ACCESS_LEVEL_UPDATE SMALLINT,ALARM_INTERVAL_MINUTES SMALLINT,ALARM_REPEAT INTEGER,ATTACH_URL VARCHAR(256),CREATED_AT TIMESTAMP,CREATED_BY_ INTEGER DEFAULT -1,DESCRIPTION CLOB(10000000),DISABLED BOOLEAN,MODIFIED_BY_ INTEGER DEFAULT -1,NAME VARCHAR(256),OWNER_ INTEGER DEFAULT -1,REFERENCE VARCHAR(256),REMINDER_STATE SMALLINT,TRIGGER_ACTION SMALLINT,TRIGGER_AT TIMESTAMP,"P$$PARENT" VARCHAR(256),DTYPE VARCHAR(256),MODIFIED_AT TIMESTAMP,AUTOCALC_TRIGGER_AT BOOLEAN,LAST_ALARM_AT TIMESTAMP,TRIGGER_END_AT TIMESTAMP)
CREATE MEMORY TABLE PUBLIC.OOCKE1_REMINDER_(OBJECT_ID VARCHAR(256) NOT NULL,IDX INTEGER NOT NULL,CREATED_BY VARCHAR(256),MODIFIED_BY VARCHAR(256),OWNER VARCHAR(256),DTYPE VARCHAR(256),PRIMARY KEY(OBJECT_ID,IDX))
CREATE VIEW PUBLIC.OOCKE1_JOIN_OBJHASASSREMINDER (CRX_OBJECT,ASSIGNED_REMINDER) AS SELECT R.REFERENCE AS CRX_OBJECT,R.OBJECT_ID AS ASSIGNED_REMINDER FROM PUBLIC.OOCKE1_REMINDER R
