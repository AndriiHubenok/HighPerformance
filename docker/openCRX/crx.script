CREATE VIEW PUBLIC.OOCKE1_JOIN_DEPPOSCONTAINSINVL (POSITION,INVENTORY_LEVEL) AS SELECT L.POSITION AS POSITION,L.OBJECT_ID AS INVENTORY_LEVEL FROM PUBLIC.OOCKE1_INVENTORYLEVEL L
CREATE VIEW PUBLIC.OOCKE1_JOIN_DEPPOSHASDEPREPITM (DEPOT_REPORT_ITEM,DEPOT_POSITION) AS SELECT DRI.OBJECT_ID AS DEPOT_REPORT_ITEM,DRI.POSITION AS DEPOT_POSITION FROM PUBLIC.OOCKE1_DEPOTREPORTITEM DRI
CREATE VIEW PUBLIC.OOCKE1_JOIN_OBJHASIDXENTRY (INDEXED,INDEX_ENTRY) AS SELECT E.INDEXED_OBJECT AS INDEXED,E.OBJECT_ID AS INDEX_ENTRY FROM PUBLIC.OOCKE1_INDEXENTRY E
CREATE VIEW PUBLIC.OOCKE1_TOBJ_PRODUCTMEMBERSHIP (OBJECT_ID,"P$$PARENT",PRODUCT_FROM,PRODUCT_TO,CREATED_AT,CREATED_BY_,MODIFIED_AT,MODIFIED_BY_,DTYPE,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_UPDATE,ACCESS_LEVEL_DELETE,OWNER_,"NAME",DESCRIPTION,RELATED_PRODUCT,RELATIONSHIP_TYPE,DISABLED,USER_BOOLEAN0,USER_BOOLEAN1,USER_BOOLEAN2,USER_BOOLEAN3,USER_BOOLEAN4_,USER_CODE0,USER_CODE1,USER_CODE2,USER_CODE3,USER_CODE4_,USER_DATE0,USER_DATE1,USER_DATE2,USER_DATE3,USER_DATE4_,USER_DATE_TIME0,USER_DATE_TIME1,USER_DATE_TIME2,USER_DATE_TIME3,USER_DATE_TIME4_,USER_NUMBER0,USER_NUMBER1,USER_NUMBER2,USER_NUMBER3,USER_NUMBER4_,USER_STRING0,USER_STRING1,USER_STRING2,USER_STRING3,USER_STRING4_) AS SELECT REPLACE(R.PRODUCT,'/','*')||'*'||REPLACE(R.OBJECT_ID,'/','*')AS OBJECT_ID,R.PRODUCT AS "P$$PARENT",R."P$$PARENT" AS PRODUCT_FROM,R.PRODUCT AS PRODUCT_TO,R.MODIFIED_AT AS CREATED_AT,R.CREATED_BY_,R.MODIFIED_AT,R.MODIFIED_BY_,REPLACE(R.DTYPE,'RelatedProduct','ProductMembership')AS DTYPE,R.ACCESS_LEVEL_BROWSE,R.ACCESS_LEVEL_UPDATE,R.ACCESS_LEVEL_DELETE,R.OWNER_,R.NAME,R.DESCRIPTION,R.OBJECT_ID AS RELATED_PRODUCT,R.RELATIONSHIP_TYPE,R.DISABLED,R.USER_BOOLEAN0,R.USER_BOOLEAN1,R.USER_BOOLEAN2,R.USER_BOOLEAN3,R.USER_BOOLEAN4_,R.USER_CODE0,R.USER_CODE1,R.USER_CODE2,R.USER_CODE3,R.USER_CODE4_,R.USER_DATE0,R.USER_DATE1,R.USER_DATE2,R.USER_DATE3,R.USER_DATE4_,R.USER_DATE_TIME0,R.USER_DATE_TIME1,R.USER_DATE_TIME2,R.USER_DATE_TIME3,R.USER_DATE_TIME4_,R.USER_NUMBER0,R.USER_NUMBER1,R.USER_NUMBER2,R.USER_NUMBER3,R.USER_NUMBER4_,R.USER_STRING0,R.USER_STRING1,R.USER_STRING2,R.USER_STRING3,R.USER_STRING4_ FROM PUBLIC.OOCKE1_RELATEDPRODUCT R
CREATE VIEW PUBLIC.OOCKE1_TOBJ_PRODUCTMEMBERSHIP_ (OBJECT_ID,"P$$PARENT",IDX,CREATED_BY,MODIFIED_BY,OWNER,DTYPE,USER_BOOLEAN4,USER_CODE4,USER_DATE4,USER_DATE_TIME4,USER_NUMBER4,USER_STRING4) AS SELECT RP_.OBJECT_ID,RP."P$$PARENT",RP_.IDX,RP_.CREATED_BY,RP_.MODIFIED_BY,RP_.OWNER,RP_.DTYPE,RP_.USER_BOOLEAN4,RP_.USER_CODE4,RP_.USER_DATE4,RP_.USER_DATE_TIME4,RP_.USER_NUMBER4,RP_.USER_STRING4 FROM PUBLIC.OOCKE1_RELATEDPRODUCT_ RP_ INNER JOIN PUBLIC.OOCKE1_RELATEDPRODUCT RP ON RP_.OBJECT_ID=RP.OBJECT_ID
CREATE VIEW PUBLIC.OOCKE1_TOBJ_SINGLEBKE (OBJECT_ID,"P$$PARENT",DTYPE,ACCESS_LEVEL_BROWSE,ACCESS_LEVEL_DELETE,ACCESS_LEVEL_UPDATE,BOOKING_DATE,ORIGIN,BOOKING_STATUS,BOOKING_TYPE,BOOKING_TEXT,CB,CREATED_AT,CREATED_BY_,DEPOT,DEPOT_ENTITY,DEPOT_HOLDER,DESCRIPTION,MODIFIED_BY_,NAME,ORIGIN_CONTEXT_PARAMS_,ORIGIN_CONTEXT_,OWNER_,POSITION,SINGLE_BOOKING,VALUE_DATE,MODIFIED_AT,QUANTITY_DEBIT,QUANTITY_CREDIT) AS SELECT REPLACE(B.OBJECT_ID,'booking/','bookingEntry/')AS OBJECT_ID,B."P$$PARENT" AS "P$$PARENT",'org:opencrx:kernel:depot1:SingleBookingEntry'AS DTYPE,B.ACCESS_LEVEL_BROWSE AS ACCESS_LEVEL_BROWSE,B.ACCESS_LEVEL_DELETE AS ACCESS_LEVEL_DELETE,B.ACCESS_LEVEL_UPDATE AS ACCESS_LEVEL_UPDATE,B.BOOKING_DATE AS BOOKING_DATE,B.ORIGIN AS ORIGIN,B.BOOKING_STATUS AS BOOKING_STATUS,B.BOOKING_TYPE AS BOOKING_TYPE,B.BOOKING_TEXT AS BOOKING_TEXT,B.CB AS CB,B.CREATED_AT AS CREATED_AT,B.CREATED_BY_ AS CREATED_BY_,(SELECT DP."P$$PARENT" FROM PUBLIC.OOCKE1_DEPOTPOSITION DP WHERE B.POSITION=DP.OBJECT_ID)AS DEPOT,(SELECT DH."P$$PARENT" FROM PUBLIC.OOCKE1_DEPOTHOLDER DH INNER JOIN PUBLIC.OOCKE1_DEPOT D ON D."P$$PARENT"=DH.OBJECT_ID INNER JOIN PUBLIC.OOCKE1_DEPOTPOSITION DP ON DP."P$$PARENT"=D.OBJECT_ID WHERE B.POSITION=DP.OBJECT_ID)AS DEPOT_ENTITY,(SELECT D."P$$PARENT" FROM PUBLIC.OOCKE1_DEPOT D INNER JOIN PUBLIC.OOCKE1_DEPOTPOSITION DP ON DP."P$$PARENT"=D.OBJECT_ID WHERE B.POSITION=DP.OBJECT_ID)AS DEPOT_HOLDER,B.DESCRIPTION AS DESCRIPTION,B.MODIFIED_BY_ AS MODIFIED_BY_,B.NAME AS NAME,B.ORIGIN_CONTEXT_PARAMS_ AS ORIGIN_CONTEXT_PARAMS_,B.ORIGIN_CONTEXT_ AS ORIGIN_CONTEXT_,B.OWNER_ AS OWNER_,B.POSITION AS POSITION,B.OBJECT_ID AS SINGLE_BOOKING,B.VALUE_DATE AS VALUE_DATE,B.MODIFIED_AT AS MODIFIED_AT,B.QUANTITY_DEBIT AS QUANTITY_DEBIT,B.QUANTITY_CREDIT AS QUANTITY_CREDIT FROM PUBLIC.OOCKE1_BOOKING B
CREATE VIEW PUBLIC.OOCKE1_TOBJ_SINGLEBKE_ (OBJECT_ID,IDX,DTYPE,CREATED_BY,MODIFIED_BY,ORIGIN_CONTEXT,ORIGIN_CONTEXT_PARAMS,OWNER) AS SELECT REPLACE(B_.OBJECT_ID,'booking/','bookingEntry/')AS OBJECT_ID,B_.IDX AS IDX,'org:opencrx:kernel:depot1:SingleBookingEntry'AS DTYPE,B_.CREATED_BY AS CREATED_BY,B_.MODIFIED_BY AS MODIFIED_BY,B_.ORIGIN_CONTEXT AS ORIGIN_CONTEXT,B_.ORIGIN_CONTEXT_PARAMS AS ORIGIN_CONTEXT_PARAMS,B_.OWNER AS OWNER FROM PUBLIC.OOCKE1_BOOKING_ B_
CREATE VIEW PUBLIC.OOCKE1_JOIN_BOCONTAINSBKE (BOOKING_ORIGIN,BOOKING_ENTRY) AS SELECT BE.ORIGIN AS BOOKING_ORIGIN,BE.OBJECT_ID AS BOOKING_ENTRY FROM PUBLIC.OOCKE1_TOBJ_SINGLEBKE BE
CREATE VIEW PUBLIC.OOCKE1_JOIN_DEPCONTAINSBKE (DEPOT,BOOKING_ENTRY) AS SELECT BE.DEPOT AS DEPOT,BE.OBJECT_ID AS BOOKING_ENTRY FROM PUBLIC.OOCKE1_TOBJ_SINGLEBKE BE
CREATE VIEW PUBLIC.OOCKE1_JOIN_DEPENTCONTAINSBKE (DEPOT_ENTITY,BOOKING_ENTRY) AS SELECT BE.DEPOT_ENTITY AS DEPOT_ENTITY,BE.OBJECT_ID AS BOOKING_ENTRY FROM PUBLIC.OOCKE1_TOBJ_SINGLEBKE BE
CREATE VIEW PUBLIC.OOCKE1_JOIN_DEPHOLCONTAINSBKE (DEPOT_HOLDER,BOOKING_ENTRY) AS SELECT BE.DEPOT_HOLDER AS DEPOT_HOLDER,BE.OBJECT_ID AS BOOKING_ENTRY FROM PUBLIC.OOCKE1_TOBJ_SINGLEBKE BE
CREATE VIEW PUBLIC.OOCKE1_JOIN_DEPPOSCONTAINSBKE (POSITION,BOOKING_ENTRY) AS SELECT BE.POSITION AS POSITION,BE.OBJECT_ID AS BOOKING_ENTRY FROM PUBLIC.OOCKE1_TOBJ_SINGLEBKE BE
