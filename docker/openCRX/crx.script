INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/144',1,NULL,NULL,'Root:admin-Root.User','org:opencrx:kernel:code1:CodeValueEntry','Qualifier: (der Qualifier von Objekten muss eindeutig sein! Bitte nicht ver\u00e4ndern, falls Ihnen die Bedeutung unklar ist)',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/144',2,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Calificador: (debe de ser unico, i.e. dejar sin cambios a menos que sepas que estas haciendo)',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/144',3,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Qualifier: (\u9664\u975e\u77e5\u9053\u4fee\u6539\u7684\u539f\u56e0\uff0c\u5426\u5219\u4e0d\u8981\u4fee\u6539\u8fd9\u4e2a\u503c)',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/144',4,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Qualifier: (objektets Qualifier m\u00e5ste vara entydig best\u00e4mt. Var god \u00e4ndra ej om du ej k\u00e4nner till vad detta betyder.',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/144',5,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Niteleyici (Tekil bir de\u011fer olmal\u0131d\u0131r. Ne yapt\u0131\u011f\u0131n\u0131z\u0131 bilmiyorsan\u0131z oldu\u011fu gibi b\u0131rak\u0131n\u0131z !)',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/144',6,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','&#1578;&#1608;&#1589;&#1610;&#1607;: &#1610;&#1606; &#1588;&#1606;&#1575;&#1587;&#1607; &#1576;&#1610;&#1583; &#1605;&#1606;&#1581;&#1589;&#1585; &#1576;&#1601;&#1585;&#1583; &#1576;&#1575;&#1588;&#1583; &#1578;&#1575; &#1608;&#1602;&#1578;&#1610; &#1705;&#1607; &#1605;&#1592;&#1605;&#1574;&#1606; &#1606;&#1610;&#1587;&#1578;&#1610;&#1583; &#1608;&#1610;&#1585;&#1575;&#1610;&#1588; &#1606;&#1606;&#1605;&#1575;&#1610;&#1610;&#1583;',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/144',7,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Qualificateur (doit \u00eatre unique, laissez le tel quel sauf si vous savez ce que vous faites...)',NULL)
INSERT INTO OOCKE1_CODEVALUEENTRY_ VALUES('valueContainerEntry/CRX/Root/TextsBundle/144',8,NULL,NULL,NULL,'org:opencrx:kernel:code1:CodeValueEntry','Identificatore: (deve essere univoco, lascia invariato se non sei sicuro...)',NULL)
