,USER_STRING0 VARCHAR(256),USER_STRING1 VARCHAR(256),USER_STRING2 VARCHAR(256),USER_STRING3 VARCHAR(256),USER_STRING4_ INTEGER DEFAULT -1,DTYPE VARCHAR(256),MODIFIED_AT TIMESTAMP)
